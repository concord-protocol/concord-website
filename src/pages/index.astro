---
import Marketing from '../layouts/Marketing.astro';
import Hero from '../components/sections/Hero.astro';
import Apps from '../components/sections/Apps.astro';
import RelayView from '../components/sections/RelayView.astro';
import ThreeJobs from '../components/sections/ThreeJobs.astro';
import Features from '../components/sections/Features.astro';
import ClientsPreview from '../components/sections/ClientsPreview.astro';
import Comparison from '../components/sections/Comparison.astro';
import BuildPreview from '../components/sections/BuildPreview.astro';
import SpecIndex from '../components/sections/SpecIndex.astro';
import CTA from '../components/sections/CTA.astro';
---

<Marketing
  title="Concord — end-to-end encrypted communities on Nostr"
  description="Concord is an open protocol for end-to-end encrypted communities and channels on Nostr. Every message is sealed on your device before it leaves, and no relay can read a message, produce a member list, or decide who is in charge."
>
  <Hero />
  <Apps />
  <RelayView />
  <ThreeJobs />
  <Features />
  <ClientsPreview />
  <Comparison />
  <BuildPreview />
  <SpecIndex />
  <CTA />
</Marketing>

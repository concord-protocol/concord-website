---
/*
 * The full list, in the same card the homepage uses — icon, one line, chips,
 * a button — rather than the three essays this page used to be. An app is a
 * thing you look at and press, and the previous version put two paragraphs of
 * prose between the reader and every download button, including a block
 * explaining which one to pick that the cards can say by their own shape.
 *
 * Equals here, deliberately: the homepage pair is where the site makes a
 * recommendation, and this is the page that just lists what exists — a list
 * that is expected to get longer, which is why nothing on it counts itself.
 */
import { Image } from 'astro:assets';
import Marketing from '../layouts/Marketing.astro';
import LinkIcon from '../components/LinkIcon.astro';
import LibrariesAndBots from '../components/sections/LibrariesAndBots.astro';
import { CLIENTS, type LinkIcon as Icon } from '../data/site';

/** Listings that install and update the app, as opposed to files to download. */
const STORE_ICONS = new Set<Icon>(['google-play', 'fdroid', 'zapstore']);

/** What every client agrees on, which is the reason there can be more of them. */
const SHARED = [
  {
    term: 'One identity',
    detail: 'Sign in to any of them with the same Nostr key.',
  },
  {
    term: 'Your communities',
    detail: 'Join in one app and the community shows up in the others.',
  },
  {
    term: 'Invites',
    detail: 'An invite link from any app opens in every other.',
  },
  {
    term: 'Roles and moderation',
    detail: 'Channels, roles, bans, and pins are the same everywhere you look.',
  },
];
---

<Marketing
  title="Clients · Concord"
  description="Armada, Vector, Amethyst, PosterChan, Grimoire, Accordion, and Coinos are independent applications that speak the Concord protocol. A community created in one opens in the others."
>
  <section class="relative overflow-hidden border-b border-hairline">
    <div class="cx-radial pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-20">
      <p class="cx-eyebrow">Clients</p>
      <h1
        class="mt-4 max-w-3xl text-balance text-4xl font-semibold leading-tight tracking-tight text-white sm:text-5xl"
      >
        Independent apps. One protocol.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-300">
        A community made in one opens in the others.
      </p>
    </div>
  </section>

  <section class="relative overflow-hidden">
    <div class="cx-grid-bg pointer-events-none absolute inset-0 opacity-60"></div>
    <div class="cx-radial pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-16">
      {/*
        One panel per app, stacked, every panel sharing the same columns. The
        panel keeps what the old cards had — each app is an object you can
        point at — without what made them noise: seven boxes each repeating
        their own "Stores" and "Downloads" labels and wrapping their links
        onto as many lines as they needed. Here each label is said once, in
        the header, and the eye runs down a column to find its own system.

        Below `lg` the columns fold into a stack per row, and the header goes,
        since there are no columns left for it to name.
      */}
      <div
        class="hidden px-6 pb-3 font-mono text-[0.65rem] uppercase tracking-[0.18em] text-gray-500 lg:grid lg:grid-cols-[minmax(0,1fr)_6.5rem_8.5rem_12rem_10rem] lg:gap-x-8"
        aria-hidden="true"
      >
        <span>App</span>
        <span>Stores</span>
        <span>Downloads</span>
        <span></span>
        <span></span>
      </div>

      <ul class="space-y-3">
        {
          CLIENTS.map((client) => {
            /*
             * The first link is the install, and gets the button. Stores and
             * files are bare marks, named on hover and in the accessible
             * label; the few pages worth a word — a page of every build, an
             * about page, a handbook, the repository — stay text.
             *
             * A closed-source client has no repository to append.
             */
            const rest = client.links.slice(1);
            const stores = rest.filter((link) => link.icon && STORE_ICONS.has(link.icon));
            const files = rest.filter((link) => link.icon && !STORE_ICONS.has(link.icon));
            const pages = rest.filter((link) => !link.icon);
            if (client.source) pages.push({ label: 'Source', href: client.source });

            return (
              <li
                class="cx-app grid items-center gap-x-8 gap-y-4 p-5 sm:px-6 lg:grid-cols-[minmax(0,1fr)_6.5rem_8.5rem_12rem_10rem]"
                style={`--glow: ${client.glow}`}
              >
                {/* The hover field; see .cx-app-noise and the script below. */}
                <canvas class="cx-app-noise" aria-hidden="true" />
                <div class="flex min-w-0 items-center gap-4">
                  {/*
                    Clipped to roughly the radius the icons already draw
                    themselves at, so marks from as many teams sit as a set.
                    `alt=""` because the name is right beside it.
                  */}
                  <Image
                    src={client.logo}
                    alt=""
                    width={44}
                    height={44}
                    densities={[2]}
                    class="cx-app-logo h-11 w-11 shrink-0 rounded-[13%]"
                  />
                  <div class="min-w-0">
                    <h2 class="text-lg font-semibold tracking-tight text-white">
                      {client.name}
                      <span class="ml-2 font-mono text-xs font-normal text-gray-500">
                        {client.author}
                      </span>
                    </h2>
                    <p class="mt-0.5 text-sm text-gray-400">{client.tagline}</p>
                  </div>
                </div>

                {/*
                  On a phone the two mark groups share one line, with a gap
                  between them standing in for the header's column break.
                */}
                <div class="hidden flex-wrap items-center gap-x-6 gap-y-2 has-[li]:flex lg:contents lg:has-[li]:contents">
                  {[stores, files].map((links) => (
                    <ul class="-ml-1.5 flex flex-wrap empty:hidden lg:empty:block">
                      {links.map((link) => (
                        <li>
                          <a
                            href={link.href}
                            rel="noopener"
                            title={link.label}
                            aria-label={`${client.name}: ${link.label}`}
                            class="grid h-8 w-8 place-items-center text-gray-300 transition-colors hover:text-white"
                          >
                            <LinkIcon icon={link.icon!} size={18} />
                          </a>
                        </li>
                      ))}
                    </ul>
                  ))}
                </div>

                <div class="flex flex-wrap gap-x-4 gap-y-1">
                  {pages.map((link) => (
                    <a
                      href={link.href}
                      rel="noopener"
                      class="text-sm text-gray-400 transition-colors hover:text-gray-100"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>

                <a
                  href={client.links[0].href}
                  rel="noopener"
                  class="cx-btn cx-btn-primary w-full whitespace-nowrap px-4 py-2.5 text-sm"
                >
                  {client.links[0].label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  {/*
    Bots and libraries each get a section of their own, under a heading, on
    a ground a shade off the page's. They used to continue the client grid
    behind a hairline, and read as more of the same list; they are not. A
    client is where you talk, a bot is something you invite into the room,
    and a library is what either is made from, so each is a stop on the way
    down the page rather than a few more rows of the list above.
  */}
  <section class="border-t border-hairline bg-raised/40">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <p class="cx-eyebrow">Bridges &amp; bots</p>
      <h2
        class="mt-4 text-balance text-2xl font-semibold leading-tight tracking-tight text-white sm:text-3xl"
      >
        Invite help into a community.
      </h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-gray-400">
        Each one joins on an invite like any member, and holds only the role
        it is granted.
      </p>

      {/*
        Bridges first, lit, and set apart from the bots under their own label:
        they are what lets an existing Discord or Matrix community talk to its
        Concord counterpart before anyone moves.
      */}
      <div class="mt-12">
        <h3 class="text-base font-semibold text-white">Bridges</h3>
        <p class="mt-1 text-sm text-gray-400">
          Bring an existing community along, both ways, while it moves.
        </p>
        <div class="mt-6">
          <LibrariesAndBots group="bridges" />
        </div>
      </div>

      <div class="mt-16">
        <h3 class="text-base font-semibold text-white">Bots</h3>
        <p class="mt-1 text-sm text-gray-400">
          Moderation, answers, music, and lookups.
        </p>
        <div class="mt-6">
          <LibrariesAndBots group="bots" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-hairline">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <p class="cx-eyebrow">Libraries</p>
      <h2
        class="mt-4 text-balance text-2xl font-semibold leading-tight tracking-tight text-white sm:text-3xl"
      >
        Build your own.
      </h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-gray-400">
        Keys, planes, and encryption are handled for you. Write the client or
        the bot, not the cryptography.
      </p>
      <div class="mt-10">
        <LibrariesAndBots group="libraries" />
      </div>
    </div>
  </section>

  <section class="border-t border-hairline">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <p class="cx-eyebrow">Interoperability</p>
      <h2
        class="mt-4 text-balance text-2xl font-semibold leading-tight tracking-tight text-white sm:text-3xl"
      >
        Switch apps. Keep everything.
      </h2>

      <dl class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          SHARED.map((item) => (
            <div class="border-t border-hairline pt-5">
              <dt class="text-sm font-medium text-gray-100">{item.term}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-gray-400">
                {item.detail}
              </dd>
            </div>
          ))
        }
      </dl>

      <a
        href="/build/"
        class="mt-12 inline-flex text-sm text-mint transition-opacity hover:opacity-80"
      >
        Build your own client &rarr;
      </a>
    </div>
  </section>

</Marketing>

<script>
  import '../scripts/app-noise';
</script>

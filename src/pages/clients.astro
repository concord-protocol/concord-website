---
/*
 * The full list, in the same card the homepage uses — icon, one line, chips,
 * a button — rather than the three essays this page used to be. An app is a
 * thing you look at and press, and the previous version put two paragraphs of
 * prose between the reader and every download button, including a block
 * explaining which one to pick that the cards can say by their own shape.
 *
 * Equals here, deliberately: the homepage pair is where the site makes a
 * recommendation, and this is the page that just lists what exists — a list
 * that is expected to get longer, which is why nothing on it counts itself.
 */
import { Image } from 'astro:assets';
import Marketing from '../layouts/Marketing.astro';
import LibrariesAndBots from '../components/sections/LibrariesAndBots.astro';
import { CLIENTS } from '../data/site';

/** What every client agrees on, which is the reason there can be more of them. */
const SHARED = [
  {
    term: 'Your identity',
    detail: 'One key logs you in everywhere, across Concord and the wider Nostr network.',
  },
  {
    term: 'Your memberships',
    detail: 'The Community List syncs across your devices and across clients.',
  },
  {
    term: 'Invite links',
    detail: 'An invite minted by one client opens in another.',
  },
  {
    term: 'The community itself',
    detail: 'Roles, channels, bans, and pins are protocol state, folded identically.',
  },
];
---

<Marketing
  title="Clients — Concord"
  description="Armada, Vector, and Accordion are independent applications that speak the Concord protocol. A community created in one opens in the others."
>
  <section class="relative overflow-hidden border-b border-hairline">
    <div class="cx-radial pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-20">
      <p class="cx-eyebrow">Clients</p>
      <h1
        class="mt-4 max-w-3xl text-balance text-4xl font-semibold leading-tight tracking-tight text-white sm:text-5xl"
      >
        Independent apps. One protocol.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-300">
        A community made in one opens in the others.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="grid gap-4 lg:grid-cols-3">
        {
          CLIENTS.map((client) => {
            /*
             * The first link is the install, and gets the button. The rest are
             * small text beneath it — Armada's two Android stores, Vector's
             * handbook — with the repository appended once. Two of the three
             * already carry their source in `links`, so it is filtered out
             * before being added back, and none of them prints it twice.
             */
            const extras = client.links
              .slice(1)
              .filter((link) => link.href !== client.source);

            return (
              <article class="cx-card flex flex-col p-7 sm:p-8">
                <div class="flex items-center gap-4">
                  {/*
                    Clipped to roughly the radius the icons already draw
                    themselves at, so three marks from three teams sit as a
                    set. `alt=""` because the name is in the heading beside it.
                  */}
                  <Image
                    src={client.logo}
                    alt=""
                    width={56}
                    height={56}
                    densities={[2]}
                    class="h-14 w-14 shrink-0 rounded-[13%]"
                  />
                  <div class="min-w-0">
                    <h2 class="text-2xl font-semibold tracking-tight text-white">
                      {client.name}
                    </h2>
                    <p class="mt-1 font-mono text-xs text-gray-500">
                      by {client.author}
                    </p>
                  </div>
                </div>

                <p class="mt-6 text-sm text-mint">{client.tagline}</p>

                <p class="mt-3 text-sm leading-relaxed text-gray-400">
                  {client.summary}
                </p>

                <ul class="mt-6 flex flex-wrap gap-1.5">
                  {client.platforms.map((platform) => (
                    <li class="rounded-md border border-hairline px-2 py-1 font-mono text-[0.65rem] text-gray-400">
                      {platform}
                    </li>
                  ))}
                </ul>

                <div class="mt-auto pt-8">
                  <a
                    href={client.links[0].href}
                    rel="noopener"
                    class="cx-btn cx-btn-primary w-full"
                  >
                    {client.links[0].label}
                  </a>

                  <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
                    {[...extras, { label: 'Source', href: client.source }].map(
                      (link) => (
                        <a
                          href={link.href}
                          rel="noopener"
                          class="text-sm text-gray-400 transition-colors hover:text-gray-100"
                        >
                          {link.label}
                        </a>
                      ),
                    )}
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>

      {/*
        The rest of what is installable, continuing the same grid: the SDK a
        client is written with, and the bots that already sit in somebody's
        community. Inside this section rather than after it, because they are
        further rows of the list above rather than a subject of their own.
      */}
      <LibrariesAndBots />
    </div>
  </section>

  <section class="border-t border-hairline">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <p class="cx-eyebrow">Interoperability</p>
      <h2
        class="mt-4 text-balance text-2xl font-semibold leading-tight tracking-tight text-white sm:text-3xl"
      >
        What travels between them.
      </h2>

      <dl class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          SHARED.map((item) => (
            <div class="border-t border-hairline pt-5">
              <dt class="text-sm font-medium text-gray-100">{item.term}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-gray-400">
                {item.detail}
              </dd>
            </div>
          ))
        }
      </dl>

      <a
        href="/build/"
        class="mt-12 inline-flex text-sm text-mint transition-opacity hover:opacity-80"
      >
        Build your own client &rarr;
      </a>
    </div>
  </section>

</Marketing>

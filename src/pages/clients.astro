---
/*
 * Every client, listed as equals (the homepage is where the site recommends
 * one), then what they share, then the bridges, bots, libraries, and apps
 * built on Concord.
 */
import { Image } from 'astro:assets';
import Marketing from '../layouts/Marketing.astro';
import LinkIcon from '../components/LinkIcon.astro';
import Logo from '../components/Logo.astro';
import LibrariesAndBots from '../components/sections/LibrariesAndBots.astro';
import { CLIENTS, type LinkIcon as Icon } from '../data/site';

/** Listings that install and update the app, as opposed to files to download. */
const STORE_ICONS = new Set<Icon>(['google-play', 'fdroid', 'zapstore']);

/** Shared by every client. Icon paths are from Lucide (ISC). */
const SHARED = [
  {
    term: 'One identity',
    detail: 'Sign in to any of them with the same Nostr key.',
    /* A key. */
    icon: [
      'M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4Z',
      'M16.5 7.5h.01',
    ],
  },
  {
    term: 'Your communities',
    detail: 'Join in one client and the community shows up in the others.',
    /* Two people. */
    icon: [
      'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2',
      'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
      'M22 21v-2a4 4 0 0 0-3-3.87',
      'M16 3.13a4 4 0 0 1 0 7.75',
    ],
  },
  {
    term: 'Invites',
    detail: 'An invite link from any client opens in every other.',
    /* A chain link. */
    icon: [
      'M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71',
      'M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71',
    ],
  },
  {
    term: 'Roles and moderation',
    detail: 'Channels, roles, bans, and pins are the same everywhere you look.',
    /* A shield with a check. */
    icon: [
      'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z',
      'm9 12 2 2 4-4',
    ],
  },
];

/** The diagram's ring, as a percentage of its square. */
const ORBIT = 40;

/** Seconds for the packet to go once round. */
const LAP = 9;

/**
 * How far along the ring, as a percentage, the packet's head starts. The
 * longest tail layer runs from the top to here.
 */
const PACKET_REACH = 26;

/** Each client's spot on the ring, starting at the top and going clockwise. */
const ORBITING = CLIENTS.map((client, i) => {
  const angle = (i / CLIENTS.length) * 2 * Math.PI - Math.PI / 2;
  return {
    client,
    x: +(50 + ORBIT * Math.cos(angle)).toFixed(2),
    y: +(50 + ORBIT * Math.sin(angle)).toFixed(2),
    /* When the packet's head reaches this client, in seconds into a lap. */
    arrival: +(((i / CLIENTS.length - PACKET_REACH / 100 + 1) % 1) * LAP).toFixed(2),
  };
});

/**
 * The packet's tail: layers sharing a front, shorter ones brighter, so it
 * fades out behind the head.
 */
const TAIL = [26, 18, 12, 7, 3.5, 1.2].map((length, i, all) => ({
  length,
  opacity: +(((i + 1) / all.length) ** 2).toFixed(2),
  width: +(0.45 + (0.5 * i) / (all.length - 1)).toFixed(2),
}));

/**
 * A trail of bits shed beside the tail: dashes and gaps of varied, fixed
 * lengths over the tail's span, then nothing for the rest of the lap.
 */
const BITS = (seed: number) => {
  const dashes: number[] = [];
  let used = 0;
  for (let k = 0; used < PACKET_REACH - 2; k++) {
    const dash = 0.3 + ((k * 7 + seed * 3) % 5) * 0.25;
    const gap = 0.6 + ((k * 5 + seed) % 4) * 0.55;
    dashes.push(dash, gap);
    used += dash + gap;
  }
  /* The last gap runs out the lap. An odd count would repeat the list and
     turn this gap into a dash. */
  dashes[dashes.length - 1] += 100 - used;
  return dashes.map((n) => +n.toFixed(2)).join(' ');
};

/*
 * The packet changes colour by crossfading one copy per client, since
 * opacity animates on the compositor and stroke colour would repaint every
 * frame. Each copy is fully shown at its client's arrival and gone by the
 * next, so the keyframes depend on how many clients there are.
 */
const SHARE = +(100 / CLIENTS.length).toFixed(4);
const HUE_KEYFRAMES = `@keyframes cx-packet-hue {
  0%, 100% { opacity: 1; }
  ${SHARE}%, ${100 - SHARE}% { opacity: 0; }
}`;
---

<Marketing
  title="Clients | Concord"
  description="Clients that speak the Concord protocol, plus the bridges, bots, and libraries built on it. Sign in to any of them with the same Nostr key."
>
  {/*
    The heading and the list are one section on one background, like the
    homepage hero: the glow shows through the grid lines (`.cx-grid-bg-center`).
  */}
  <section class="relative overflow-hidden">
    <div class="cx-grid-bg cx-grid-bg-center pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-6xl px-5 pb-24 pt-20">
      <div class="text-center">
        <p class="cx-outline-title text-2xl uppercase">Clients</p>
        <h1
          class="mx-auto mt-4 max-w-3xl text-balance text-4xl font-semibold leading-tight tracking-tight text-white sm:text-5xl"
        >
          Many clients, all in concord.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-300">
          Built by different people, speaking the same language.
        </p>
      </div>

      {/*
        One row per client on shared columns, with the column labels in a single
        header. Below `lg` each row stacks and the header is hidden.
      */}
      <div
        class="mt-16 hidden px-6 pb-3 font-mono text-[0.65rem] uppercase tracking-[0.18em] text-gray-500 lg:grid lg:grid-cols-[minmax(0,1fr)_6.5rem_8.5rem_12rem_10rem] lg:gap-x-8"
        aria-hidden="true"
      >
        <span>Client</span>
        <span>Stores</span>
        <span>Downloads</span>
        <span></span>
        <span></span>
      </div>

      <ul class="mt-16 space-y-3 lg:mt-0">
        {
          CLIENTS.map((client) => {
            /*
             * The first link gets the button. Stores and downloads are icons
             * (named in `title` and `aria-label`); other pages are text.
             */
            const rest = client.links.slice(1);
            const stores = rest.filter((link) => link.icon && STORE_ICONS.has(link.icon));
            const files = rest.filter((link) => link.icon && !STORE_ICONS.has(link.icon));
            const pages = rest.filter((link) => !link.icon);
            if (client.source) pages.push({ label: 'Source', href: client.source });

            return (
              <li
                class="cx-app grid items-center gap-x-8 gap-y-4 p-5 sm:px-6 lg:grid-cols-[minmax(0,1fr)_6.5rem_8.5rem_12rem_10rem]"
                style={`--glow: ${client.glow}`}
              >
                {/* The hover field; see .cx-app-noise and the script below. */}
                <canvas class="cx-app-noise" aria-hidden="true" />
                <div class="flex min-w-0 items-center gap-4">
                  <Image
                    src={client.logo}
                    alt=""
                    width={44}
                    height={44}
                    densities={[2]}
                    class="cx-app-logo h-11 w-11 shrink-0 rounded-[13%]"
                  />
                  <div class="min-w-0">
                    <h2 class="text-lg font-semibold tracking-tight text-white">
                      {client.name}
                      <span class="ml-2 font-mono text-xs font-normal text-gray-500">
                        {client.author}
                      </span>
                    </h2>
                    <p class="mt-0.5 text-sm text-gray-400">{client.tagline}</p>
                  </div>
                </div>

                {/* Below `lg`, stores and downloads share one line. */}
                <div class="hidden flex-wrap items-center gap-x-6 gap-y-2 has-[li]:flex lg:contents lg:has-[li]:contents">
                  {[stores, files].map((links) => (
                    <ul class="-ml-1.5 flex flex-wrap empty:hidden lg:empty:block">
                      {links.map((link) => (
                        <li>
                          <a
                            href={link.href}
                            rel="noopener"
                            title={link.label}
                            aria-label={`${client.name}: ${link.label}`}
                            class="grid h-8 w-8 place-items-center text-gray-300 transition-colors hover:text-white"
                          >
                            <LinkIcon icon={link.icon!} size={18} />
                          </a>
                        </li>
                      ))}
                    </ul>
                  ))}
                </div>

                <div class="flex flex-wrap gap-x-4 gap-y-1">
                  {pages.map((link) => (
                    <a
                      href={link.href}
                      rel="noopener"
                      class="text-sm text-gray-400 transition-colors hover:text-gray-100"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>

                <a
                  href={client.links[0].href}
                  rel="noopener"
                  class="cx-btn cx-btn-glow cx-btn-sm w-full"
                >
                  {client.links[0].label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  {/*
    The lower sections share one opening: a mint rule fading out at both ends
    and a faint glow under it, echoing the hero above.
  */}
  <section class="relative overflow-hidden">
    <div class="cx-rule absolute inset-x-0 top-0"></div>
    <div class="cx-radial pointer-events-none absolute inset-0 opacity-50"></div>
    <div
      class="relative mx-auto grid max-w-6xl items-center gap-x-16 gap-y-16 px-5 py-24 lg:grid-cols-[minmax(0,1fr)_26rem]"
    >
      <div>
        <p class="cx-outline-title origin-left text-2xl uppercase">Interoperability</p>
        <h2
          class="mt-4 text-balance text-2xl font-semibold leading-tight tracking-tight text-white sm:text-3xl"
        >
          Switch clients. Keep everything.
        </h2>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-gray-400">
          A community doesn't live inside an app. It lives on relays, as
          encrypted events in one shared format, and every client above reads
          the same events. They differ in what they build around a community,
          not in the community itself.
        </p>

        <dl class="mt-10 grid gap-x-8 gap-y-7 sm:grid-cols-2">
          {
            SHARED.map((item) => (
              <div class="flex gap-4">
                <span
                  class="grid h-9 w-9 shrink-0 place-items-center rounded-[13%] border border-mint/30 bg-mint/10 text-mint"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-[1.125rem] w-[1.125rem]"
                  >
                    {item.icon.map((d) => (
                      <path d={d} />
                    ))}
                  </svg>
                </span>
                <div>
                  <dt class="text-sm font-semibold text-white">{item.term}</dt>
                  <dd class="mt-1 text-sm leading-relaxed text-gray-400">
                    {item.detail}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>

        <a
          href="/build/#interoperability"
          class="mt-10 inline-flex text-sm text-mint transition-opacity hover:opacity-80"
        >
          How clients stay compatible &rarr;
        </a>
      </div>

      {/*
        Every client around one community, each wired to it in its own glow,
        with a packet circling through them all. Positions are percentages of
        the square, so the lines (in a 100-unit viewBox) and the logos
        (absolutely placed) line up at any size.

        Everything that moves animates only transform, scale, and opacity on
        one CSS clock, so the blurred SVG is rasterized once and the compositor
        does the rest.
      */}
      <div class="relative mx-auto aspect-square w-full max-w-[26rem]" aria-hidden="true">
        <svg viewBox="0 0 100 100" class="absolute inset-0 h-full w-full overflow-visible">
          <defs>
            {/* Spokes fade from the client's glow to almost nothing at the centre. */}
            {ORBITING.map(({ client, x, y }, i) => (
              <linearGradient
                id={`spoke-${i}`}
                gradientUnits="userSpaceOnUse"
                x1={x}
                y1={y}
                x2="50"
                y2="50"
              >
                <stop offset="0" stop-color={client.glow} stop-opacity="0.6" />
                <stop offset="1" stop-color={client.glow} stop-opacity="0.05" />
              </linearGradient>
            ))}
            <filter id="packet-glow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="0.6" result="near" />
              <feGaussianBlur stdDeviation="2.2" result="far" />
              <feMerge>
                <feMergeNode in="far" />
                <feMergeNode in="near" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
            <filter id="packet-haze" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="2.5" />
            </filter>
          </defs>

          <circle
            cx="50"
            cy="50"
            r={ORBIT}
            fill="none"
            stroke="white"
            stroke-opacity="0.06"
            vector-effect="non-scaling-stroke"
          />

          {ORBITING.map(({ x, y }, i) => (
            <line
              x1="50"
              y1="50"
              x2={x}
              y2={y}
              stroke={`url(#spoke-${i})`}
              vector-effect="non-scaling-stroke"
            />
          ))}
        </svg>

        {/*
          The packet, drawn still with its head PACKET_REACH along from the top
          and turned a lap by its wrapper. One copy per client glow crossfades
          to the next as the head passes each client; the white core is shared.
        */}
        <div class="cx-packet absolute inset-0" style={`--lap: ${LAP}s`}>
          {ORBITING.map(({ client, arrival }) => (
            <svg
              viewBox="0 0 100 100"
              class="cx-packet-hue absolute inset-0 h-full w-full overflow-visible"
              style={`animation-delay: ${(arrival - LAP).toFixed(2)}s`}
            >
              <g
                transform="rotate(-90 50 50)"
                fill="none"
                stroke={client.glow}
                stroke-linecap="round"
              >
                {/* A wide blur under the tail, for the haze it leaves. */}
                <circle
                  cx="50"
                  cy="50"
                  r={ORBIT}
                  pathLength="100"
                  stroke-width="4"
                  stroke-opacity="0.22"
                  stroke-dasharray="16 84"
                  stroke-dashoffset={16 - PACKET_REACH}
                  filter="url(#packet-haze)"
                />
                {[ORBIT - 1.4, ORBIT + 1.4].map((r, k) => (
                  <circle
                    cx="50"
                    cy="50"
                    r={r}
                    pathLength="100"
                    stroke-width="0.35"
                    stroke-opacity="0.55"
                    stroke-linecap="butt"
                    stroke-dasharray={BITS(k + 1)}
                    stroke-dashoffset="-2"
                  />
                ))}
                <g filter="url(#packet-glow)">
                  {TAIL.map(({ length, opacity, width }) => (
                    <circle
                      cx="50"
                      cy="50"
                      r={ORBIT}
                      pathLength="100"
                      stroke-width={width}
                      stroke-opacity={opacity}
                      stroke-dasharray={`${length} ${100 - length}`}
                      stroke-dashoffset={length - PACKET_REACH}
                    />
                  ))}
                </g>
              </g>
            </svg>
          ))}
          <svg viewBox="0 0 100 100" class="absolute inset-0 h-full w-full overflow-visible">
            <circle
              cx="50"
              cy="50"
              r={ORBIT}
              pathLength="100"
              transform="rotate(-90 50 50)"
              fill="none"
              stroke="white"
              stroke-width="0.7"
              stroke-linecap="round"
              stroke-dasharray="0.3 99.7"
              stroke-dashoffset={0.3 - PACKET_REACH}
            />
          </svg>
        </div>

        {/* The community breathes: a glow behind it fades in and out. */}
        <div class="absolute left-1/2 top-1/2 h-24 w-24 -translate-x-1/2 -translate-y-1/2">
          <div class="cx-hub-glow absolute -inset-10 rounded-full"></div>
          <div
            class="relative grid h-full w-full place-items-center rounded-full border border-mint/30 bg-surface shadow-[0_0_40px_rgba(36,232,163,0.18)]"
          >
            <Logo size={52} />
          </div>
        </div>

        {/* Each logo flares as the packet's head passes under it. */}
        {
          ORBITING.map(({ client, x, y, arrival }) => (
            <div
              class="absolute h-12 w-12 -translate-x-1/2 -translate-y-1/2"
              style={`left: ${x}%; top: ${y}%; --glow: ${client.glow}; --lap: ${LAP}s; --delay: ${(arrival - LAP - 0.2).toFixed(2)}s`}
            >
              <div class="cx-node-flare absolute -inset-6 rounded-full"></div>
              <Image
                src={client.logo}
                alt=""
                width={48}
                height={48}
                densities={[2]}
                class="cx-node relative h-12 w-12 rounded-[13%] bg-black"
                style={`box-shadow: 0 0 24px ${client.glow}55`}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden">
    <div class="cx-rule absolute inset-x-0 top-0"></div>
    <div class="cx-radial pointer-events-none absolute inset-0 opacity-50"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-24">
      <p class="cx-outline-title origin-left text-2xl uppercase">Bridges &amp; bots</p>
      <h2
        class="mt-4 text-balance text-2xl font-semibold leading-tight tracking-tight text-white sm:text-3xl"
      >
        Invite help into a community.
      </h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-gray-400">
        These join a community through an invite, like any member, and can do
        only what their role allows.
      </p>

      <div class="mt-12">
        <h3 class="text-base font-semibold text-white">Bridges</h3>
        <p class="mt-1 text-sm text-gray-400">
          Connect a Concord channel to a Discord channel or Matrix room, so
          messages show up on both sides.
        </p>
        <div class="mt-6">
          <LibrariesAndBots group="bridges" />
        </div>
      </div>

      <div class="mt-16">
        <h3 class="text-base font-semibold text-white">Bots</h3>
        <p class="mt-1 text-sm text-gray-400">
          Moderation, answers, music, and lookups.
        </p>
        <div class="mt-6">
          <LibrariesAndBots group="bots" more />
        </div>
      </div>

      <a
        href="/build/bots/"
        class="mt-12 inline-flex text-sm text-mint transition-opacity hover:opacity-80"
      >
        How bots work &rarr;
      </a>
    </div>
  </section>

  <section class="relative overflow-hidden">
    <div class="cx-rule absolute inset-x-0 top-0"></div>
    <div class="cx-radial pointer-events-none absolute inset-0 opacity-50"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-24">
      <p class="cx-outline-title origin-left text-2xl uppercase">Build</p>
      <h2
        class="mt-4 text-balance text-2xl font-semibold leading-tight tracking-tight text-white sm:text-3xl"
      >
        Build your own.
      </h2>

      <div class="mt-12">
        <h3 class="text-base font-semibold text-white">Libraries</h3>
        <p class="mt-1 text-sm text-gray-400">
          These handle key derivation, encryption, and relay traffic, so a
          client or bot doesn't have to implement them itself.
        </p>
        <div class="mt-6">
          <LibrariesAndBots group="libraries" />
        </div>
      </div>

      <div class="mt-16">
        <h3 class="text-base font-semibold text-white">Built on Concord</h3>
        <p class="mt-1 text-sm text-gray-400">
          Applications that use Concord communities for something other than
          chat.
        </p>
        <div class="mt-6">
          <LibrariesAndBots group="apps" more />
        </div>
      </div>

      <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-sm text-mint">
        <a href="/build/sdks/" class="transition-opacity hover:opacity-80">
          SDKs and libraries &rarr;
        </a>
        <a href="/build/" class="transition-opacity hover:opacity-80">
          Build your own client &rarr;
        </a>
      </div>
    </div>
  </section>
</Marketing>

<script>
  import '../scripts/app-noise';
</script>

<style is:inline set:html={HUE_KEYFRAMES}></style>

<style>
  /* One lap, turned on the compositor. */
  .cx-packet {
    will-change: transform;
    animation: cx-packet-spin var(--lap) linear infinite;
  }

  @keyframes cx-packet-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .cx-packet-hue {
    opacity: 0;
    will-change: opacity;
    animation: cx-packet-hue var(--lap) linear infinite;
  }

  /*
   * A logo flares as the packet passes, decaying over a beat: it swells
   * slightly and a soft glow in its colour blooms behind it.
   */
  .cx-node {
    animation: cx-node-swell var(--lap) ease-out var(--delay) infinite;
  }

  .cx-node-flare {
    opacity: 0;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--glow) 55%, transparent) 0%,
      transparent 65%
    );
    will-change: opacity;
    animation: cx-node-bloom var(--lap) ease-out var(--delay) infinite;
  }

  @keyframes cx-node-swell {
    0%,
    22%,
    100% {
      scale: 1;
    }
    3% {
      scale: 1.08;
    }
  }

  @keyframes cx-node-bloom {
    0%,
    25%,
    100% {
      opacity: 0;
    }
    3% {
      opacity: 1;
    }
  }

  .cx-hub-glow {
    background: radial-gradient(circle, rgba(36, 232, 163, 0.28) 0%, transparent 62%);
    will-change: opacity;
    animation: cx-hub-breathe 5s ease-in-out infinite alternate;
  }

  @keyframes cx-hub-breathe {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cx-packet {
      display: none;
    }

    .cx-node,
    .cx-node-flare,
    .cx-hub-glow {
      animation: none;
    }
  }
</style>

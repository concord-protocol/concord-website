---
import Marketing from '../layouts/Marketing.astro';

const links = [
  { label: 'What is Concord?', href: '/learn/what-is-concord/' },
  { label: 'The CORD documents', href: '/spec/' },
  { label: 'Clients', href: '/clients/' },
  { label: 'Build on Concord', href: '/build/' },
];
---

<Marketing
  title="Not found — Concord"
  description="That page does not exist."
>
  <section class="relative overflow-hidden">
    <div class="cx-radial pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-2xl px-5 py-32 text-center">
      <p class="cx-eyebrow">404</p>
      <h1
        class="mt-5 text-balance text-4xl font-semibold tracking-tight text-white sm:text-5xl"
      >
        Nothing decrypts here.
      </h1>
      <p class="mt-6 text-base leading-relaxed text-gray-400">
        That page does not exist, or it moved. Try one of these instead.
      </p>

      <ul class="mt-10 flex flex-wrap justify-center gap-2.5">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="cx-btn cx-btn-ghost">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Marketing>

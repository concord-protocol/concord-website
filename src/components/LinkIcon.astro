---
/*
 * Monochrome platform or store icon for an install link, in the link's colour.
 * Decorative; the link carries the label.
 *
 * Platform, F-Droid, and Google Play paths are Simple Icons (CC0). Zapstore's
 * bolt is traced from its app icon, which has no flat version. The Windows
 * tiles are hand-drawn.
 */
import type { LinkIcon } from '../data/site';
import Android from '../assets/icons/android.svg';
import Apple from '../assets/icons/apple.svg';
import FDroid from '../assets/icons/fdroid.svg';
import GooglePlay from '../assets/icons/google-play.svg';
import Linux from '../assets/icons/linux.svg';
import Windows from '../assets/icons/windows.svg';
import Zapstore from '../assets/icons/zapstore.svg';

interface Props {
  icon: LinkIcon;
  /** Edge length in pixels. */
  size?: number;
}

const { icon, size = 16 } = Astro.props;

const SVGS = {
  android: Android,
  apple: Apple,
  fdroid: FDroid,
  'google-play': GooglePlay,
  linux: Linux,
  windows: Windows,
  zapstore: Zapstore,
} as const;

const Svg = SVGS[icon];
---

<Svg width={size} height={size} class="shrink-0" aria-hidden="true" />

---
/**
 * The shape of a group chat, drawn twice.
 *
 * Both variants place the same six members in the same ring, so the pair can be
 * read as one picture: the only thing that changes between them is the middle.
 * `hosted` converges every line on a single box that reads everything passing
 * through it; `concord` spreads the same traffic over three interchangeable
 * relays, each carrying sealed packets and none of them load-bearing.
 *
 * The colour does as much work as the geometry — the hosted diagram is drawn
 * entirely in the neutral ramp and the Concord one in mint.
 */
interface Props {
  variant: 'hosted' | 'concord';
  class?: string;
  /** Sentence describing the picture, for assistive tech. */
  label: string;
}

const { variant, class: className = '', label } = Astro.props;

const CX = 200;
const CY = 150;

/** Rounded to a tenth of a user unit: sub-pixel at every size this renders at,
    and it keeps sixteen digits of float noise out of the built HTML. */
const round = (n: number) => Math.round(n * 10) / 10;

/** Points on an ellipse about the centre, clockwise from twelve o'clock. */
const ring = (n: number, rx: number, ry: number) =>
  Array.from({ length: n }, (_, i) => {
    const a = ((-90 + (360 / n) * i) * Math.PI) / 180;
    return { x: round(CX + rx * Math.cos(a)), y: round(CY + ry * Math.sin(a)) };
  });

const members = ring(6, 158, 118);

/*
 * One hub dead centre, or three arranged in a triangle inside the ring. Sized
 * so the three never overlap each other and never reach a member dot.
 */
const hubs = variant === 'hosted' ? [{ x: CX, y: CY }] : ring(3, 68, 78);

/*
 * Each member links to its two nearest hubs. With one hub that degrades to the
 * star every hosted chat really is; with three it draws the mesh that makes
 * them interchangeable — no member depends on any particular one.
 */
const links = members.flatMap((m) =>
  hubs
    .map((h) => ({ h, d: Math.hypot(h.x - m.x, h.y - m.y) }))
    .sort((a, b) => a.d - b.d)
    .slice(0, 2)
    .map(({ h }) => ({ m, h, d: Math.hypot(h.x - m.x, h.y - m.y) }))
);

/*
 * A packet on the wire, 45% of the way out from the member. Short links skip
 * theirs: the marker would land under the dot or the hub it runs between.
 */
const packets = links
  .filter((l) => l.d > 70)
  .map(({ m, h }) => ({
    x: round(m.x + (h.x - m.x) * 0.45),
    y: round(m.y + (h.y - m.y) * 0.45),
  }));

const hosted = variant === 'hosted';
const wire = hosted ? '#2d3d36' : 'rgba(36, 232, 163, 0.42)';
const pip = hosted ? '#43574e' : '#24e8a3';

const HUB = hosted
  ? { w: 128, h: 78, rx: 12, label: 'SERVER' }
  : { w: 84, h: 30, rx: 15, label: 'RELAY' };
---

<svg
  viewBox="0 0 400 300"
  class:list={['w-full', className]}
  fill="none"
  role="img"
  aria-label={label}
>
  {links.map(({ m, h }) => (
    <line x1={m.x} y1={m.y} x2={h.x} y2={h.y} stroke={wire} stroke-width="1.25" />
  ))}

  {/* Sealed on the Concord side, in the clear on the hosted one. */}
  {packets.map((p) => (
    <rect
      x={p.x - 3}
      y={p.y - 3}
      width="6"
      height="6"
      rx="1.5"
      fill={pip}
      opacity={hosted ? '0.55' : '0.85'}
    />
  ))}

  {/* After the wires, so the lines disappear beneath them. */}
  {hubs.map((h) => (
    <>
      <rect
        x={h.x - HUB.w / 2}
        y={h.y - HUB.h / 2}
        width={HUB.w}
        height={HUB.h}
        rx={HUB.rx}
        fill="#0e1512"
        stroke={hosted ? '#43574e' : 'rgba(36, 232, 163, 0.45)'}
        stroke-width="1.25"
      />
      <text
        x={h.x}
        y={h.y}
        text-anchor="middle"
        dominant-baseline="central"
        class="font-mono"
        font-size="11"
        letter-spacing="1.6"
        fill={hosted ? '#9fb3aa' : '#24e8a3'}
      >
        {HUB.label}
      </text>
    </>
  ))}

  {members.map((m) => (
    <>
      <circle cx={m.x} cy={m.y} r="13" fill="#0e1512" stroke="#1b2621" stroke-width="1.25" />
      <circle cx={m.x} cy={m.y} r="4.5" fill={pip} />
    </>
  ))}
</svg>

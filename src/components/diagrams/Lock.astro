---
/**
 * A padlock on a device screen, drawn in the device's dark body colour with a
 * keyhole in the screen colour, so it reads as a cutout.
 *
 * Drawn about its own origin, like {@link Packet}, and placed by the caller.
 */
interface Props {
  /** Centre of the lock, in the caller's user units. */
  x: number;
  y: number;
}

const { x, y } = Astro.props;

/** Matches the device screen fill in RelayMesh.astro. */
const SCREEN = 'rgba(36, 232, 163, 0.4)';
const BODY = '#0e1512';
---

<g transform={`translate(${x} ${y})`}>
  {/* Shackle: a semicircle with straight legs down into the body. */}
  <path
    d="M -3.2 -2.5 v -2.4 a 3.2 3.2 0 0 1 6.4 0 v 2.4"
    fill="none"
    stroke={BODY}
    stroke-width="1.8"
    stroke-linecap="round"
  />
  <rect x="-5.5" y="-2.5" width="11" height="8.5" rx="2" fill={BODY} />
  <circle cx="0" cy="1.75" r="1.3" fill={SCREEN} />
</g>

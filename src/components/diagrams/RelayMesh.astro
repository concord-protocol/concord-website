---
/**
 * Devices wired to relays, with hex packets moving along each wire and one
 * relay going offline in rotation. The wide SVG is shown from `md` up; a
 * stacked version replaces it on phones.
 *
 * Coordinates are hand-placed and irregular; evenly spaced positions made the
 * wires form a hexagram.
 */
import Lock from './Lock.astro';
import Packet from './Packet.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

/** Rounded to a tenth of a user unit: sub-pixel at every size this renders at. */
const round = (n: number) => Math.round(n * 10) / 10;

/* Devices around the edge of the 1000×600 view box. */
const DEVICES = [
  { x: 120, y: 95, kind: 'phone' },
  { x: 520, y: 80, kind: 'laptop' },
  { x: 905, y: 105, kind: 'phone' },
  { x: 900, y: 400, kind: 'laptop' },
  { x: 690, y: 545, kind: 'phone' },
  { x: 395, y: 555, kind: 'phone' },
  { x: 155, y: 455, kind: 'laptop' },
] as const;

/* Real public Nostr relays. */
const RELAYS = [
  { x: 300, y: 190, name: 'relay.dreamith.to' },
  { x: 735, y: 195, name: 'relay.ditto.pub' },
  { x: 545, y: 450, name: 'jskitty.com/nostr' },
  { x: 455, y: 295, name: 'asia.vectorapp.io/nostr' },
  /* The rest of the network: drawn as a stack, linked to nostr.watch, and
     excluded from the offline rotation. */
  {
    x: 240,
    y: 320,
    name: '1000+ more',
    more: true,
    href: 'https://nostr.watch/',
  },
];

const relays = RELAYS.map((relay, index) => ({
  ...relay,
  id: `relay-${index}`,
}));

/* Placeholder hex for the packets. Seeded LCG so rebuilds produce identical
   HTML; the script below randomizes it in the browser. */
let seed = 0x5eed1e;
const rand = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 2 ** 32);
const HEX = '0123456789abcdef';
const hex = (n: number) =>
  Array.from({ length: n }, () => HEX[(rand() * HEX.length) | 0]).join('');

/* Each device links to its two nearest relays, so it stays connected when
   one is offline. */
const links = DEVICES.flatMap((d) =>
  relays
    .map((r) => ({ d, r, dist: Math.hypot(r.x - d.x, r.y - d.y) }))
    .sort((a, b) => a.dist - b.dist)
    .slice(0, 2)
).map(({ d, r }, index) => ({
  relay: r.id,
  path: `M ${d.x} ${d.y} L ${r.x} ${r.y}`,
  packet: hex(6),
  /* Packet position under reduced motion: 42% along the wire, clear of both
     ends. */
  still: {
    x: round(d.x + (r.x - d.x) * 0.42),
    y: round(d.y + (r.y - d.y) * 0.42),
  },
  /* Alternate direction per link, with varied durations and staggered starts. */
  inbound: index % 2 === 1,
  duration: 2.4 + (index % 4) * 0.3,
  delay: round(index * 0.22),
}));

/* Offline relay before the script starts, and permanently under reduced
   motion. */
const INITIAL_DOWN = 'relay-1';
---

<div class:list={[className]}>
  {/* Wide version, md and up. */}
  <svg
    viewBox="0 0 1000 600"
    class="hidden w-full md:block"
    role="img"
    aria-label="Seven devices — phones and laptops, each with a padlock on its screen — scattered around three named relay servers and a stack standing for a thousand more, each device wired to the two nearest. Every wire carries hex. One server is dark, and the mesh carries on around it."
  >
    {
      links.map((link) => (
        <g class="cx-arc" data-relay={link.relay} data-down={link.relay === INITIAL_DOWN ? '' : undefined}>
          <path
            d={link.path}
            fill="none"
            stroke="rgba(36, 232, 163, 0.22)"
            stroke-width="1.5"
          />
        </g>
      ))
    }

    {/*
      Static packets for reduced motion. The animated group below is hidden in
      that case, since freezing it would leave packets at arbitrary points.
    */}
    {
      links.map((link) => (
        <g
          class="cx-packets motion-safe:hidden"
          data-relay={link.relay}
          data-down={link.relay === INITIAL_DOWN ? '' : undefined}
        >
          <g transform={`translate(${link.still.x} ${link.still.y})`}>
            <Packet
              hex={link.packet}
              fill={link.inbound ? '#96ffd6' : '#24e8a3'}
              opacity={link.inbound ? '0.5' : '0.85'}
            />
          </g>
        </g>
      ))
    }

    {
      links.map((link) => (
        <g
          class="cx-packets motion-reduce:hidden"
          data-relay={link.relay}
          data-down={link.relay === INITIAL_DOWN ? '' : undefined}
        >
          {/*
            The animation lives on this wrapper, not the <text>: the churn
            script sets `textContent`, which would delete an <animateMotion>
            inside the text.
          */}
          <g>
            {/*
              Negative begin so packets are mid-flight on the first frame. A
              positive delay leaves them at the SVG origin until it elapses.
            */}
            <animateMotion
              dur={`${link.duration}s`}
              begin={`-${link.delay}s`}
              repeatCount="indefinite"
              path={link.path}
              keyPoints={link.inbound ? '1;0' : undefined}
              keyTimes={link.inbound ? '0;1' : undefined}
              calcMode={link.inbound ? 'linear' : undefined}
            />
            {/* Fade at both ends to hide the jump back to the start on each
                repeat. */}
            <animate
              attributeName="opacity"
              values="0;1;1;0"
              keyTimes="0;0.12;0.88;1"
              dur={`${link.duration}s`}
              begin={`-${link.delay}s`}
              repeatCount="indefinite"
            />
            <Packet
              hex={link.packet}
              fill={link.inbound ? '#96ffd6' : '#24e8a3'}
              opacity={link.inbound ? '0.5' : '0.85'}
              churn
            />
          </g>
        </g>
      ))
    }

    {/*
      Relays as server racks, drawn after the wires so wires pass behind them.
      Gray, since mint marks the user's own devices and data.
    */}
    {
      relays.map((relay, index) => (
        <g
          class:list={['cx-node', relay.more && 'cx-more']}
          data-relay={relay.id}
          data-static={relay.more ? '' : undefined}
          data-down={relay.id === INITIAL_DOWN ? '' : undefined}
        >
          {/* Two offset racks behind the front one, for the stack. */}
          {relay.more && (
            <>
              <rect
                x={relay.x - 20}
                y={relay.y - 36}
                width="64"
                height="48"
                rx="6"
                fill="#0e1512"
                stroke="#1b2621"
                stroke-width="1.5"
              />
              <rect
                x={relay.x - 26}
                y={relay.y - 30}
                width="64"
                height="48"
                rx="6"
                fill="#0e1512"
                stroke="#23302a"
                stroke-width="1.5"
              />
            </>
          )}
          <rect
            class="cx-node-box"
            x={relay.x - 32}
            y={relay.y - 24}
            width="64"
            height="48"
            rx="6"
            fill="#0e1512"
            stroke="#2d3d36"
            stroke-width="1.5"
          />
          {/*
            Three bays, each with a light and a vent. The top light turns red
            when the relay is offline. Per-light duration and phase are passed
            as custom properties so the lights don't blink in sync; the
            keyframes are in the scoped style block.
          */}
          {[-16, 0, 16].map((offset, bay) => (
            <>
              <circle
                class:list={['cx-node-led', bay === 0 && 'cx-node-fault']}
                data-bay={bay}
                style={`--cx-led-dur: ${(1.1 + bay * 0.37 + index * 0.19).toFixed(2)}s; --cx-led-delay: -${(0.31 * bay + 0.53 * index).toFixed(2)}s`}
                cx={relay.x - 21}
                cy={relay.y + offset}
                r="3"
                fill="#24e8a3"
              />
              <rect
                x={relay.x - 11}
                y={relay.y + offset - 2}
                width="28"
                height="4"
                rx="2"
                fill="#1b2621"
              />
            </>
          ))}
          <line
            x1={relay.x - 32}
            y1={relay.y - 8}
            x2={relay.x + 32}
            y2={relay.y - 8}
            stroke="#1b2621"
            stroke-width="1.25"
          />
          <line
            x1={relay.x - 32}
            y1={relay.y + 8}
            x2={relay.x + 32}
            y2={relay.y + 8}
            stroke="#1b2621"
            stroke-width="1.25"
          />

          <text
            class="cx-node-name font-mono"
            x={relay.x}
            y={relay.y + 44}
            font-size="14"
            text-anchor="middle"
            fill="#6a8177"
          >
            {relay.name}
          </text>

          {/* Clickable area for the stack. src/middleware.ts adds
              target="_blank" to SVG anchors too. */}
          {relay.href && (
            <a href={relay.href} rel="noopener" aria-label="Over a thousand more public Nostr relays, counted by nostr.watch">
              <rect
                x={relay.x - 36}
                y={relay.y - 42}
                width="82"
                height="98"
                fill="transparent"
              />
            </a>
          )}
        </g>
      ))
    }

    {/* Devices, drawn last so the wire ends sit underneath them. */}
    {
      DEVICES.map((device) =>
        device.kind === 'phone' ? (
          <g>
            <rect
              x={device.x - 14}
              y={device.y - 21}
              width="28"
              height="42"
              rx="6"
              fill="#0e1512"
              stroke="#24e8a3"
              stroke-width="1.5"
            />
            <rect
              x={device.x - 9}
              y={device.y - 15}
              width="18"
              height="26"
              rx="2"
              fill="rgba(36, 232, 163, 0.4)"
            />
            {/* Raised one unit to centre the lock optically, since its shackle
                extends above its origin. */}
            <Lock x={device.x} y={device.y - 1} />
            <circle cx={device.x} cy={device.y + 15} r="2" fill="#24e8a3" />
          </g>
        ) : (
          <g>
            <rect
              x={device.x - 23}
              y={device.y - 19}
              width="46"
              height="32"
              rx="4"
              fill="#0e1512"
              stroke="#24e8a3"
              stroke-width="1.5"
            />
            <rect
              x={device.x - 18}
              y={device.y - 14}
              width="36"
              height="22"
              rx="2"
              fill="rgba(36, 232, 163, 0.4)"
            />
            <Lock x={device.x} y={device.y - 2} />
            <rect
              x={device.x - 29}
              y={device.y + 14}
              width="58"
              height="5"
              rx="2.5"
              fill="#24e8a3"
            />
          </g>
        )
      )
    }
  </svg>

  {/* Phone version: device, wire, relay list, wire, device. */}
  <div class="md:hidden">
    <svg
      viewBox="0 0 60 52"
      class="mx-auto h-14 w-auto"
      role="img"
      aria-label="A phone with a padlock on its screen"
    >
      <rect x="16" y="4" width="28" height="42" rx="6" fill="#0e1512" stroke="#24e8a3" stroke-width="1.5"></rect>
      <rect x="21" y="10" width="18" height="26" rx="2" fill="rgba(36, 232, 163, 0.4)"></rect>
      <Lock x={30} y={24} />
      <circle cx="30" cy="40" r="2" fill="#24e8a3"></circle>
    </svg>

    {/* A wire segment with a churning hex packet on it. */}
    <div class="my-3 flex flex-col items-center gap-1.5">
      <span class="h-4 w-px bg-mint/25"></span>
      <span class="flex items-center gap-1.5">
        <svg viewBox="0 0 16 14" class="h-3 w-3.5 shrink-0 text-mint/70" aria-hidden="true">
          <rect x="1" y="1" width="14" height="10" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.3" />
          <path d="M 4 11 v 3 l 3.5 -3 z" fill="currentColor" />
        </svg>
        <span class="font-mono text-[0.65rem] text-mint/70" data-hex>
          {links[0].packet}
        </span>
      </span>
      <span class="h-4 w-px bg-mint/25"></span>
    </div>

    <ul class="space-y-2">
      {
        relays.map((relay) => (
          <li
            class="cx-row flex items-center gap-3 rounded-lg border border-hairline px-3 py-2.5"
            data-relay={relay.id}
            data-down={relay.id === INITIAL_DOWN ? '' : undefined}
          >
            {/* Small rack icon. */}
            <svg viewBox="0 0 22 18" class="h-4 w-5 shrink-0" aria-hidden="true">
              <rect x="1" y="1" width="20" height="16" rx="2.5" fill="#0e1512" stroke="#2d3d36" stroke-width="1.25" />
              <circle class="cx-node-led cx-node-fault" style="--cx-led-dur: 1.2s" cx="5.5" cy="6" r="1.5" fill="#24e8a3" />
              <circle class="cx-node-led" data-bay="1" style="--cx-led-dur: 1.5s; --cx-led-delay: -0.4s" cx="5.5" cy="12" r="1.5" fill="#24e8a3" />
              <rect x="9" y="4.75" width="9" height="2.5" rx="1.25" fill="#1b2621" />
              <rect x="9" y="10.75" width="9" height="2.5" rx="1.25" fill="#1b2621" />
            </svg>
            <span class="cx-row-name min-w-0 truncate font-mono text-xs text-gray-400">
              {relay.name}
            </span>
            {relay.href && (
              <a
                href={relay.href}
                rel="noopener"
                class="ml-auto shrink-0 font-mono text-[0.65rem] text-mint transition-opacity hover:opacity-80"
              >
                count them &rarr;
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <div class="my-3 flex flex-col items-center gap-1.5">
      <span class="h-4 w-px bg-mint/25"></span>
      <span class="flex items-center gap-1.5">
        <svg viewBox="0 0 16 14" class="h-3 w-3.5 shrink-0 text-mint/70" aria-hidden="true">
          <rect x="1" y="1" width="14" height="10" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.3" />
          <path d="M 4 11 v 3 l 3.5 -3 z" fill="currentColor" />
        </svg>
        <span class="font-mono text-[0.65rem] text-mint/70" data-hex>
          {links[1].packet}
        </span>
      </span>
      <span class="h-4 w-px bg-mint/25"></span>
    </div>

    <svg
      viewBox="0 0 60 44"
      class="mx-auto h-12 w-auto"
      role="img"
      aria-label="A laptop with a padlock on its screen"
    >
      <rect x="7" y="4" width="46" height="32" rx="4" fill="#0e1512" stroke="#24e8a3" stroke-width="1.5"></rect>
      <rect x="12" y="9" width="36" height="22" rx="2" fill="rgba(36, 232, 163, 0.4)"></rect>
      <Lock x={30} y={19} />
      <rect x="1" y="37" width="58" height="5" rx="2.5" fill="#24e8a3"></rect>
    </svg>
  </div>
</div>

<style>
  /* Offline relay (`data-down`), for both layouts. */
  .cx-arc,
  .cx-node,
  .cx-row {
    transition: opacity 0.5s ease;
  }

  .cx-arc path {
    transition:
      stroke 0.5s ease,
      stroke-dasharray 0.5s ease;
  }

  .cx-arc[data-down] path {
    stroke: rgba(67, 87, 78, 0.45);
    stroke-dasharray: 4 6;
  }

  .cx-packets[data-down] {
    display: none;
  }

  .cx-node[data-down] {
    opacity: 0.6;
  }

  .cx-node[data-down] .cx-node-box {
    stroke: #1b2621;
  }

  .cx-row[data-down] {
    opacity: 0.55;
  }

  /* The "1000+ more" stack, which links out. */
  .cx-more {
    cursor: pointer;
  }

  .cx-more .cx-node-name {
    transition: fill 0.2s ease;
  }

  .cx-more:hover .cx-node-name {
    fill: #24e8a3;
  }

  /* Activity lights: two irregular blink patterns, `steps(1, end)` so they
     switch instead of fading, with per-light duration and phase. */
  .cx-node-led {
    animation: cx-led-a var(--cx-led-dur, 1.2s) steps(1, end) infinite;
    animation-delay: var(--cx-led-delay, 0s);
  }

  .cx-node-led[data-bay='1'] {
    animation-name: cx-led-b;
  }

  /* The top light is a power light: mostly on, with a brief dip. Without a
     steady light a live rack looked as dark as an offline one. */
  .cx-node-fault {
    animation-name: cx-led-power;
  }

  @keyframes cx-led-power {
    0%,
    91% {
      opacity: 1;
    }
    92%,
    95% {
      opacity: 0.5;
    }
    96%,
    100% {
      opacity: 1;
    }
  }

  @keyframes cx-led-a {
    0%,
    6% {
      opacity: 1;
    }
    7%,
    18% {
      opacity: 0.12;
    }
    19%,
    24% {
      opacity: 0.9;
    }
    25%,
    47% {
      opacity: 0.12;
    }
    48%,
    52% {
      opacity: 1;
    }
    53%,
    70% {
      opacity: 0.15;
    }
    71%,
    76% {
      opacity: 0.85;
    }
    77%,
    100% {
      opacity: 0.12;
    }
  }

  @keyframes cx-led-b {
    0%,
    9% {
      opacity: 0.15;
    }
    10%,
    14% {
      opacity: 1;
    }
    15%,
    30% {
      opacity: 0.12;
    }
    31%,
    34% {
      opacity: 0.8;
    }
    35%,
    58% {
      opacity: 0.15;
    }
    59%,
    66% {
      opacity: 1;
    }
    67%,
    88% {
      opacity: 0.12;
    }
    89%,
    94% {
      opacity: 0.9;
    }
    95%,
    100% {
      opacity: 0.15;
    }
  }

  /* Offline rack: all lights off except the top one, which blinks red. */
  .cx-node[data-down] .cx-node-led,
  .cx-row[data-down] .cx-node-led {
    fill: #2d3d36;
    animation: none;
    opacity: 1;
  }

  .cx-node[data-down] .cx-node-fault,
  .cx-row[data-down] .cx-node-fault {
    fill: #f87171;
    animation: cx-led-fault 0.9s steps(1, end) infinite;
  }

  @keyframes cx-led-fault {
    0%,
    45% {
      opacity: 1;
    }
    46%,
    100% {
      opacity: 0.1;
    }
  }
</style>

<script>
  /*
   * Two loops, both off under `prefers-reduced-motion`:
   * - churn the hex in every `[data-hex]` element, two characters per tick;
   * - rotate which relay is offline (`data-down`), with one all-up beat per
   *   cycle.
   */
  const GLYPHS = '0123456789abcdef';
  const CHURN_MS = 45;
  const CYCLE_MS = 2600;

  const glyph = () => GLYPHS[(Math.random() * GLYPHS.length) | 0];

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const chips = document.querySelectorAll<HTMLElement>('[data-hex]');

    if (chips.length) {
      setInterval(() => {
        for (const chip of chips) {
          const run = (chip.textContent ?? '').split('');
          if (!run.length) continue;
          for (let i = 0; i < 2; i++) {
            run[(Math.random() * run.length) | 0] = glyph();
          }
          chip.textContent = run.join('');
        }
      }, CHURN_MS);
    }

    /* Every relay-related element in both layouts carries `data-relay`. */
    const parts = document.querySelectorAll<HTMLElement>('[data-relay]');

    if (parts.length) {
      /* Relays marked `data-static` (the "1000+ more" stack) never go offline.
         Only the node carries the flag; its wires and packets are excluded by
         relay id. */
      const fixed = new Set(
        [...document.querySelectorAll<HTMLElement>('[data-static]')].map(
          (part) => part.dataset.relay
        )
      );

      const names = [...new Set([...parts].map((part) => part.dataset.relay ?? ''))].filter(
        (name) => name && !fixed.has(name)
      );

      /* `null` is a turn with every relay up. */
      const turns: Array<string | null> = [...names, null];
      let turn = turns.indexOf(
        document.querySelector('[data-down]')?.getAttribute('data-relay') ?? null
      );

      setInterval(() => {
        turn = (turn + 1) % turns.length;
        const down = turns[turn];
        for (const part of parts) {
          part.toggleAttribute('data-down', part.dataset.relay === down);
        }
      }, CYCLE_MS);
    }
  }
</script>

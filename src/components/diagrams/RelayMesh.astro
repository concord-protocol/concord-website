---
/**
 * Six members, three relays, and hex on every wire.
 *
 * The shape is the one the comparison card used: the same ring of members
 * around a triangle of interchangeable relays, each member wired to its two
 * nearest, so no member depends on any particular relay. What it borrows from
 * the constellation on soapbox.pub/armada is the life — packets actually
 * moving, and a relay dropping out on a cycle while nothing else changes.
 *
 * The encryption is the part the geometry cannot say on its own, so the ends
 * say it. Two members hold the message in the clear, one sending and one
 * receiving, and between them every wire and every relay carries hex. The
 * same sentence at both ends and nowhere in between is the whole claim, drawn
 * rather than asserted.
 *
 * Nothing is labelled "encrypted" inside the picture. A reader who can see
 * that the middle is unreadable does not need to be told, and the line under
 * the diagram names it once for the reader who wants the word.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const CX = 500;
const CY = 260;

/** Rounded to a tenth of a user unit: sub-pixel at every size this renders at,
    and it keeps sixteen digits of float noise out of the built HTML. */
const round = (n: number) => Math.round(n * 10) / 10;

/** Points on an ellipse about the centre, clockwise from twelve o'clock. */
const ring = (n: number, rx: number, ry: number) =>
  Array.from({ length: n }, (_, i) => {
    const a = ((-90 + (360 / n) * i) * Math.PI) / 180;
    return { x: round(CX + rx * Math.cos(a)), y: round(CY + ry * Math.sin(a)) };
  });

const members = ring(6, 400, 205);

/*
 * Three, in a triangle inside the ring, placed so none of them reaches a member
 * dot or overlaps another. They are named, and named after real ones: "RELAY"
 * three times reads as a generic box in a systems diagram, and the whole point
 * is that these are ordinary public Nostr relays that already exist and were
 * not built for this.
 *
 * Each pill is sized to its own label — JetBrains Mono advances at about 0.6em,
 * so the text width is known here without measuring anything.
 */
const NAMES = ['relay.damus.io', 'relay.ditto.pub', 'nos.lol'];

const relays = ring(3, 165, 130).map((point, index) => ({
  ...point,
  id: `relay-${index}`,
  name: NAMES[index],
  width: Math.max(120, Math.round(NAMES[index].length * 8.4) + 40),
}));

/*
 * Ciphertext that has to look like ciphertext without being any: hex, which is
 * what a reader who has ever seen an event id or a key recognises on sight. A
 * seeded LCG rather than Math.random, so a rebuild doesn't churn the HTML.
 */
let seed = 0x5eed1e;
const rand = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 2 ** 32);
const HEX = '0123456789abcdef';
const hex = (n: number) =>
  Array.from({ length: n }, () => HEX[(rand() * HEX.length) | 0]).join('');

/*
 * Each member links to its two nearest relays, which is what makes them
 * interchangeable: losing one costs every member a spare, not a connection.
 */
const links = members
  .flatMap((m) =>
    relays
      .map((r) => ({ m, r, d: Math.hypot(r.x - m.x, r.y - m.y) }))
      .sort((a, b) => a.d - b.d)
      .slice(0, 2)
  )
  .map(({ m, r }, index) => ({
    relay: r.id,
    path: `M ${m.x} ${m.y} L ${r.x} ${r.y}`,
    packet: `${hex(6)}…`,
    /* Where the packet sits when it is not allowed to move. Short of halfway,
       so it clears both the member's dot and the relay's pill. */
    still: { x: round(m.x + (r.x - m.x) * 0.42), y: round(m.y + (r.y - m.y) * 0.42) },
    /* Alternating, so the mesh reads as a conversation rather than as an
       upload, and staggered so it is traffic rather than a metronome. */
    inbound: index % 2 === 1,
    duration: 2.4 + (index % 4) * 0.3,
    delay: round(index * 0.22),
  }));

/** The room, in the two places it exists in the clear. */
const MESSAGE = 'venue’s booked for the 14th';
const SENDER = members[5];
const RECIPIENT = members[2];

/*
 * Whichever relay is dark before the script takes over, and the one it stays
 * on for anybody who has turned motion off.
 */
const INITIAL_DOWN = 'relay-1';
---

<div class:list={[className]}>
  {/*
    The wide version. The stacked one below carries the same argument on a
    phone, where six members around a ring would put every label at 5px.
  */}
  <svg
    viewBox="0 0 1000 520"
    class="hidden w-full md:block"
    role="img"
    aria-label="Six members in a ring around three interchangeable relays, each member wired to the two nearest. The message is readable at the sending member and at the receiving one; every wire and every relay in between carries hex. One relay is dark, and the mesh carries on around it."
  >
    {
      links.map((link) => (
        <g class="cx-arc" data-relay={link.relay} data-down={link.relay === INITIAL_DOWN ? '' : undefined}>
          <path
            d={link.path}
            fill="none"
            stroke="rgba(36, 232, 163, 0.22)"
            stroke-width="1.5"
          />
        </g>
      ))
    }

    {/*
      What is actually on the wire, for a reader who has asked for no motion:
      the same hex, parked. The animated group below is hidden in that case
      rather than frozen, since a run of hex stopped at an arbitrary point of
      its flight reads as a rendering bug.
    */}
    {
      links.map((link) => (
        <g
          class="cx-packets motion-safe:hidden"
          data-relay={link.relay}
          data-down={link.relay === INITIAL_DOWN ? '' : undefined}
        >
          <text
            x={link.still.x}
            y={link.still.y}
            class="font-mono"
            font-size="13"
            fill={link.inbound ? '#96ffd6' : '#24e8a3'}
            opacity={link.inbound ? '0.5' : '0.85'}
            text-anchor="middle"
            dominant-baseline="central"
          >
            {link.packet}
          </text>
        </g>
      ))
    }

    {
      links.map((link) => (
        <g
          class="cx-packets motion-reduce:hidden"
          data-relay={link.relay}
          data-down={link.relay === INITIAL_DOWN ? '' : undefined}
        >
          <text
            x="0"
            y="0"
            class="font-mono"
            font-size="13"
            fill={link.inbound ? '#96ffd6' : '#24e8a3'}
            opacity={link.inbound ? '0.5' : '0.85'}
            text-anchor="middle"
            dominant-baseline="central"
          >
            {link.packet}
            <animateMotion
              dur={`${link.duration}s`}
              begin={`${link.delay}s`}
              repeatCount="indefinite"
              path={link.path}
              keyPoints={link.inbound ? '1;0' : undefined}
              keyTimes={link.inbound ? '0;1' : undefined}
              calcMode={link.inbound ? 'linear' : undefined}
            />
          </text>
        </g>
      ))
    }

    {/* After the wires, so the lines disappear beneath them. */}
    {
      relays.map((relay) => (
        <g class="cx-node" data-relay={relay.id} data-down={relay.id === INITIAL_DOWN ? '' : undefined}>
          <rect
            class="cx-node-box"
            x={relay.x - relay.width / 2}
            y={relay.y - 22}
            width={relay.width}
            height="44"
            rx="22"
            fill="#0e1512"
            stroke="#2d3d36"
            stroke-width="1.5"
          />
          <text
            class="cx-node-name font-mono"
            x={relay.x}
            y={relay.y}
            font-size="14"
            text-anchor="middle"
            dominant-baseline="central"
            fill="#6a8177"
          >
            {relay.name}
          </text>
          {/* Nothing under a relay that is working: a label there would be
              describing an ordinary state, and the pills are already the
              busiest things in the picture. Only ever visible on a dark one;
              see the style block below. */}
          <text
            class="cx-node-off font-mono"
            x={relay.x}
            y={relay.y + 40}
            font-size="12"
            letter-spacing="1.5"
            text-anchor="middle"
            fill="#43574e"
          >
            OFFLINE
          </text>
        </g>
      ))
    }

    {
      members.map((member) => (
        <>
          <circle cx={member.x} cy={member.y} r="22" fill="#0e1512" stroke="#1b2621" stroke-width="1.5" />
          <circle cx={member.x} cy={member.y} r="8" fill="#24e8a3" />
        </>
      ))
    }

    {/*
      The two ends. Same sentence in both, which is the point: what the relays
      hold decrypts to exactly this, and only here.
    */}
    <g>
      <line
        x1={SENDER.x}
        y1={SENDER.y - 22}
        x2={SENDER.x}
        y2={SENDER.y - 40}
        stroke="rgba(36, 232, 163, 0.45)"
        stroke-width="1.5"
      />
      <rect
        x={SENDER.x - 125}
        y={SENDER.y - 102}
        width="250"
        height="62"
        rx="14"
        fill="#0e1512"
        stroke="rgba(36, 232, 163, 0.45)"
        stroke-width="1.5"
      />
      <text
        x={SENDER.x - 105}
        y={SENDER.y - 79}
        font-size="14"
        font-weight="600"
        fill="#e7f1ec"
        dominant-baseline="central"
      >
        alice
      </text>
      <text
        x={SENDER.x - 105}
        y={SENDER.y - 58}
        font-size="14"
        fill="#9fb3aa"
        dominant-baseline="central"
      >
        {MESSAGE}
      </text>
      <text
        class="font-mono"
        x={SENDER.x}
        y={SENDER.y - 114}
        font-size="12"
        text-anchor="middle"
        fill="#43574e"
      >
        on alice’s device
      </text>
    </g>

    <g>
      <line
        x1={RECIPIENT.x}
        y1={RECIPIENT.y + 22}
        x2={RECIPIENT.x}
        y2={RECIPIENT.y + 40}
        stroke="rgba(36, 232, 163, 0.45)"
        stroke-width="1.5"
      />
      <rect
        x={RECIPIENT.x - 125}
        y={RECIPIENT.y + 40}
        width="250"
        height="62"
        rx="14"
        fill="#0e1512"
        stroke="rgba(36, 232, 163, 0.45)"
        stroke-width="1.5"
      />
      <text
        x={RECIPIENT.x - 105}
        y={RECIPIENT.y + 63}
        font-size="14"
        font-weight="600"
        fill="#e7f1ec"
        dominant-baseline="central"
      >
        derek
      </text>
      <text
        x={RECIPIENT.x - 105}
        y={RECIPIENT.y + 84}
        font-size="14"
        fill="#9fb3aa"
        dominant-baseline="central"
      >
        {MESSAGE}
      </text>
      <text
        class="font-mono"
        x={RECIPIENT.x}
        y={RECIPIENT.y + 118}
        font-size="12"
        text-anchor="middle"
        fill="#43574e"
      >
        on derek’s device
      </text>
    </g>
  </svg>

  {/*
    The phone version: the same three facts stacked — the message in the clear,
    what each relay in between is holding, and the message again at the far
    end.
  */}
  <div class="md:hidden">
    <div class="cx-card p-4">
      <p class="text-sm font-semibold text-gray-100">alice</p>
      <p class="mt-1 truncate text-sm text-gray-400">{MESSAGE}</p>
    </div>
    <p class="mt-2 text-center font-mono text-[0.65rem] text-gray-500">
      on alice’s device
    </p>

    {/*
      The wire, with what is on it. Same rule as the wide diagram — hex between
      the ends, nothing at the relay — and without this the middle of the phone
      version would be three names and no evidence.
    */}
    <div class="my-3 flex flex-col items-center gap-1.5">
      <span class="h-4 w-px bg-mint/25"></span>
      <span class="font-mono text-[0.65rem] text-mint/70">{links[0].packet}</span>
      <span class="h-4 w-px bg-mint/25"></span>
    </div>

    <ul class="space-y-2">
      {
        relays.map((relay) => (
          <li
            class="cx-row flex items-center gap-3 rounded-lg border border-hairline px-3 py-2.5"
            data-relay={relay.id}
            data-down={relay.id === INITIAL_DOWN ? '' : undefined}
          >
            <span class="cx-row-dot h-2.5 w-2.5 shrink-0 rounded-full bg-gray-500" />
            <span class="cx-row-name min-w-0 truncate font-mono text-xs text-gray-400">
              {relay.name}
            </span>
            {/* Same rule as the wide diagram: a working relay says nothing. */}
            <span class="cx-row-off ml-auto shrink-0 font-mono text-[0.65rem] tracking-widest text-gray-500">
              OFFLINE
            </span>
          </li>
        ))
      }
    </ul>

    <div class="my-3 flex flex-col items-center gap-1.5">
      <span class="h-4 w-px bg-mint/25"></span>
      <span class="font-mono text-[0.65rem] text-mint/70">{links[1].packet}</span>
      <span class="h-4 w-px bg-mint/25"></span>
    </div>

    <div class="cx-card p-4">
      <p class="text-sm font-semibold text-gray-100">derek</p>
      <p class="mt-1 truncate text-sm text-gray-400">{MESSAGE}</p>
    </div>
    <p class="mt-2 text-center font-mono text-[0.65rem] text-gray-500">
      on derek’s device
    </p>
  </div>
</div>

<style>
  /* A relay that is currently dark. One state, described once, for the wide
     diagram and the stacked list alike. */
  .cx-arc,
  .cx-node,
  .cx-row {
    transition: opacity 0.5s ease;
  }

  .cx-arc path {
    transition:
      stroke 0.5s ease,
      stroke-dasharray 0.5s ease;
  }

  .cx-arc[data-down] path {
    stroke: rgba(67, 87, 78, 0.45);
    stroke-dasharray: 4 6;
  }

  .cx-packets[data-down] {
    display: none;
  }

  .cx-node[data-down] {
    opacity: 0.6;
  }

  .cx-node[data-down] .cx-node-box {
    stroke: #1b2621;
  }

  .cx-node[data-down] .cx-node-name {
    fill: #43574e;
    text-decoration: line-through;
  }

  .cx-node-off {
    opacity: 0;
  }

  .cx-node[data-down] .cx-node-off {
    opacity: 1;
  }

  .cx-row[data-down] {
    opacity: 0.55;
  }

  .cx-row[data-down] .cx-row-dot {
    background: #2d3d36;
  }

  .cx-row[data-down] .cx-row-name {
    text-decoration: line-through;
  }

  .cx-row-off {
    display: none;
  }

  .cx-row[data-down] .cx-row-off {
    display: block;
  }
</style>

<script>
  /*
   * Whose turn it is to be offline.
   *
   * Relays go down; that is the ordinary condition of the network rather than
   * an incident, and a diagram where the same one is always dark invites the
   * reader to think that one is broken. Rotating it says the thing the picture
   * is for: any of them can go, and every member still has a wire.
   *
   * Every element that has an opinion about a relay carries `data-relay`, so
   * both layouts change together and nothing here needs to know which one is
   * on screen.
   */
  const CYCLE_MS = 2600;

  const parts = document.querySelectorAll<HTMLElement>('[data-relay]');

  if (parts.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const names = [...new Set([...parts].map((part) => part.dataset.relay ?? ''))].filter(Boolean);

    /* One beat with everything up, so the mesh is not permanently missing a
       relay and the recovery is as visible as the outage. */
    const turns: Array<string | null> = [...names, null];
    let turn = turns.indexOf(
      document.querySelector('[data-down]')?.getAttribute('data-relay') ?? null
    );

    setInterval(() => {
      turn = (turn + 1) % turns.length;
      const down = turns[turn];
      for (const part of parts) {
        part.toggleAttribute('data-down', part.dataset.relay === down);
      }
    }, CYCLE_MS);
  }
</script>

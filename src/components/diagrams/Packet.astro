---
/**
 * One sealed message on the wire: a padlock, and the hex it actually is.
 *
 * The icon is what makes the run of hex legible as a *message* rather than as
 * decorative noise — a reader who sees `843def` sliding along a line knows it
 * is data, and something has to say it is somebody's sentence. A padlock says
 * that and one thing more, which is why it replaced the chat bubble that was
 * here: every message on every wire is shut, and the picture no longer needs
 * the devices to be badged for the reader to see where that leaves the relays.
 *
 * Drawn about its own origin so the caller can place it either way: the
 * animated copies hand their position to an <animateMotion> on a wrapper, and
 * the still ones translate the wrapper instead. Nothing here knows which.
 */
interface Props {
  hex: string;
  fill: string;
  opacity: string;
  /** Whether the churn loop should rewrite this one. Still copies are only
      shown under `prefers-reduced-motion`, where nothing churns. */
  churn?: boolean;
}

const { hex, fill, opacity, churn = false } = Astro.props;
---

<g opacity={opacity}>
  {/* A solid body and a stroked shackle, which is as much padlock as survives
      at eleven units wide. No keyhole: it is two more marks that close up into
      a smudge at this size, and the silhouette is already the shape everybody
      reads as shut. */}
  <path
    d="M -28.2 -2 v -2.8 a 3.2 3.2 0 0 1 6.4 0 v 2.8"
    fill="none"
    stroke={fill}
    stroke-width="1.8"
    stroke-linecap="round"
  />
  <rect x="-30.5" y="-2" width="11" height="9" rx="2" fill={fill} />
  <text
    x="-13"
    y="0"
    class="font-mono"
    data-hex={churn ? '' : undefined}
    font-size="13"
    fill={fill}
    dominant-baseline="central"
  >
    {hex}
  </text>
</g>

---
/**
 * A packet on a wire: a chat-bubble icon followed by a run of hex.
 *
 * Drawn about its own origin; the caller positions it with a transform or an
 * <animateMotion> on a wrapper.
 */
interface Props {
  hex: string;
  fill: string;
  opacity: string;
  /** Mark the hex with `data-hex` so the churn script rewrites it. */
  churn?: boolean;
}

const { hex, fill, opacity, churn = false } = Astro.props;
---

<g opacity={opacity}>
  {/* Filled, since an outline is unreadable at 16×12. */}
  <rect x="-34" y="-8" width="16" height="12" rx="3" fill={fill} />
  {/* Speech-bubble tail, bottom left. */}
  <path d="M -30 4 v 4.5 l 4.5 -4.5 z" fill={fill} />
  <text
    x="-13"
    y="0"
    class="font-mono"
    data-hex={churn ? '' : undefined}
    font-size="13"
    fill={fill}
    dominant-baseline="central"
  >
    {hex}
  </text>
</g>

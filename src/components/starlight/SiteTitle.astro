---
/**
 * Starlight `SiteTitle` override. Starlight has no top-level nav slot, so the
 * site nav links are rendered here alongside the brand, styled like Nav.astro.
 */
import Brand from '../Brand.astro';
import { NAV, isCurrent } from '../../data/site';

const path = Astro.url.pathname;
---

<div class="concord-site-title">
  <Brand />

  <nav class="concord-top-nav" aria-label="Site">
    {
      NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item, path) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .concord-site-title {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
    overflow: hidden;
  }

  .concord-top-nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  .concord-top-nav a {
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    color: var(--color-gray-400);
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .concord-top-nav a:hover {
    color: var(--color-gray-200);
  }

  .concord-top-nav a[aria-current] {
    color: var(--color-mint);
  }

  /* Starlight's mobile layout ends at 50rem. Below it the links are in the
     menu; see MobileMenuFooter.astro. */
  @media (min-width: 50rem) {
    .concord-top-nav {
      display: flex;
    }
  }
</style>

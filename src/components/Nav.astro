---
import Logo from './Logo.astro';
import { NAV, SPEC_REPO } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<!--
  Deliberately quiet: no bottom rule and only enough backdrop to keep the links
  legible over scrolled content, so the full-height hero below it reads as the
  first thing on the page.
-->
<header class="sticky top-0 z-40 bg-black/40 backdrop-blur-xl">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5"
    aria-label="Primary"
  >
    {/*
      Near enough to no gap at all, because the pair is spaced optically: the
      "C" opens toward the word and leaves the right quarter of the mark's
      viewBox empty, which together with the wordmark's own sidebearing already
      comes to about 8px. Any real gap on top of that reads as a hole.
    */}
    <a
      href="/"
      class="flex items-center gap-px transition-opacity hover:opacity-80"
    >
      <Logo size={22} />
      {/*
        The display face, as in the hero. It has one weight, so this stays at
        400 rather than the medium the rest of the nav uses — a synthesised bold
        would smear a face this geometric. Bruno Ace is wide and reads small for
        its size, so it takes a nudge up and a little tracking.
      */}
      <span
        class="cx-brand-word font-display text-[0.9375rem] tracking-[0.01em] text-gray-300"
        >Concord</span
      >
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-2 text-[0.8125rem] transition-colors',
                isActive(item.href)
                  ? 'text-mint'
                  : 'text-gray-400 hover:text-gray-200',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a
        href={SPEC_REPO}
        rel="noopener"
        class="hidden text-[0.8125rem] text-gray-400 transition-colors hover:text-mint sm:inline"
      >
        GitHub
      </a>
      <a
        href="/clients/"
        class="cx-btn cx-btn-ghost !px-3.5 !py-1.5 !text-[0.8125rem] !font-medium"
      >
        Get a client
      </a>
    </div>
  </nav>

  <ul
    class="flex items-center gap-1 overflow-x-auto px-5 pb-2 md:hidden"
  >
    {
      NAV.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'whitespace-nowrap rounded-md px-2.5 py-1 text-[0.8125rem] transition-colors',
              isActive(item.href)
                ? 'text-mint'
                : 'text-gray-400 hover:text-gray-200',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

---
import Logo from './Logo.astro';
import { NAV, SPEC_REPO } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<!--
  No bottom border and a light backdrop, so the nav sits quietly over the hero.
-->
<header class="sticky top-0 z-40 bg-black/40 backdrop-blur-xl">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5"
    aria-label="Primary"
  >
    {/*
      1px gap: the empty right side of the mark's viewBox plus the wordmark's
      sidebearing already give about 8px of space.
    */}
    <a
      href="/"
      class="flex items-center gap-px transition-opacity hover:opacity-80"
    >
      <Logo size={22} />
      {/* Bruno Ace has one weight, so no font-weight class here. */}
      <span
        class="cx-brand-word font-display text-[0.9375rem] tracking-[0.01em] text-gray-300"
        >Concord</span
      >
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-2 text-[0.8125rem] transition-colors',
                isActive(item.href)
                  ? 'text-mint'
                  : 'text-gray-400 hover:text-gray-200',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a
        href={SPEC_REPO}
        rel="noopener"
        class="hidden text-[0.8125rem] text-gray-400 transition-colors hover:text-mint sm:inline"
      >
        GitHub
      </a>
      <a
        href="/clients/"
        class="cx-btn cx-btn-ghost !px-3.5 !py-1.5 !text-[0.8125rem] !font-medium"
      >
        Install Apps
      </a>
    </div>
  </nav>

  <ul
    class="flex items-center gap-1 overflow-x-auto px-5 pb-2 md:hidden"
  >
    {
      NAV.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'whitespace-nowrap rounded-md px-2.5 py-1 text-[0.8125rem] transition-colors',
              isActive(item.href)
                ? 'text-mint'
                : 'text-gray-400 hover:text-gray-200',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

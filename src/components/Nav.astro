---
/*
 * The marketing pages' header. Laid out like the docs header
 * (starlight/Header.astro): full width, the brand and links on the left,
 * GitHub and Install Apps on the right, so nothing moves between the two.
 */
import Brand from './Brand.astro';
import { NAV, SPEC_REPO, isCurrent } from '../data/site';

const path = Astro.url.pathname;
---

<!--
  No bottom border and a light backdrop, so the nav sits quietly over the hero.
  The docs header's 1px border comes out of its 4rem, so pb-px keeps the row
  centred at the same height.
-->
<header class="sticky top-0 z-40 bg-black/40 backdrop-blur-xl">
  <nav
    class="flex h-16 items-center justify-between gap-6 px-4 pb-px min-[50rem]:px-6"
    aria-label="Primary"
  >
    <div class="flex items-center gap-6">
      <Brand />

      <ul class="hidden items-center gap-1 md:flex">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item, path) ? 'page' : undefined}
                class:list={[
                  'rounded-md px-2.5 py-1.5 text-sm transition-colors',
                  isCurrent(item, path) ? 'text-mint' : 'text-gray-400 hover:text-gray-200',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex items-center gap-4">
      <a
        href={SPEC_REPO}
        rel="noopener"
        class="hidden text-sm text-gray-400 transition-colors hover:text-mint sm:inline"
      >
        GitHub
      </a>
      <a href="/clients/" class="cx-btn cx-btn-ghost cx-btn-sm">Install Apps</a>
    </div>
  </nav>

  <ul class="flex items-center gap-1 overflow-x-auto px-4 pb-2 md:hidden">
    {
      NAV.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item, path) ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap rounded-md px-2.5 py-1 text-sm transition-colors',
              isCurrent(item, path) ? 'text-mint' : 'text-gray-400 hover:text-gray-200',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

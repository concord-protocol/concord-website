---
/**
 * The Concord mark: an outer ring split into a green "C" and a short white
 * segment, around a mint inner ring.
 *
 * Traced from src/assets/concord-logo-source.png (128px raster, where the white
 * segment is white on white and easy to miss). Geometry: centre 63.5; outer
 * ring r49 w12, "C" from +56deg to -56.5deg, segment from +43.5deg to -43.5deg;
 * inner ring r27.3 w12.5.
 */
interface Props {
  /** Rendered size in pixels; the mark is square. */
  size?: number;
  class?: string;
  /** Set when the mark is the only content of a link or button. */
  title?: string;
  /**
   * Play the entrance animation (see `.cx-mark-*` in global.css). Used only by
   * the hero lockup.
   */
  animate?: boolean;
}

const { size = 28, class: className = '', title, animate = false } = Astro.props;

/* Shared by the strokes and the halo copy drawn when animating. Also copied
   into scripts/og-image.mjs. */
const OUTER = 'M 90.90 22.88 A 49 49 0 1 0 90.54 104.36';
/* Starts at the lower terminal so it draws counter-clockwise from where the
   "C" ends, continuing the same stroke. */
const SEGMENT = 'M 99.04 97.23 A 49 49 0 0 0 99.04 29.77';
const INNER = { cx: '63.5', cy: '63.5', r: '27.3' };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 128 128"
  fill="none"
  class:list={[animate && 'cx-mark', className]}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  {
    animate && (
      <>
        {/*
          Halo: a copy of the mark under the real strokes, with a static
          drop-shadow. Its opacity animates instead of the filter, so the blur
          isn't recomputed every frame.
        */}
        <g class="cx-mark-breathe">
          <g class="cx-mark-glow cx-mark-flash">
            <circle {...INNER} stroke="#5AFDB2" stroke-width="12.5" />
            <path d={OUTER} stroke="#1DA57A" stroke-width="12" />
            <path d={SEGMENT} stroke="#FFFFFF" stroke-width="12" />
          </g>
        </g>
        {/* Expanding ring, see .cx-mark-wave. */}
        <circle
          cx="63.5"
          cy="63.5"
          r="49"
          stroke="#24e8a3"
          stroke-width="2"
          class="cx-mark-wave"
        />
      </>
    )
  }

  {/* `pathLength="1"` normalizes dash units so one set of keyframes fits every
      shape. */}
  <circle
    {...INNER}
    fill="none"
    stroke="#5AFDB2"
    stroke-width="12.5"
    pathLength={animate ? '1' : undefined}
    class:list={[animate && 'cx-mark-stroke cx-mark-stroke-inner']}
  />
  <path
    d={OUTER}
    fill="none"
    stroke="#1DA57A"
    stroke-width="12"
    pathLength={animate ? '1' : undefined}
    class:list={[animate && 'cx-mark-stroke']}
  />
  <path
    d={SEGMENT}
    fill="none"
    stroke="#FFFFFF"
    stroke-width="12"
    pathLength={animate ? '1' : undefined}
    class:list={[animate && 'cx-mark-stroke cx-mark-stroke-segment']}
  />
</svg>

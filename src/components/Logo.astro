---
/**
 * The Concord mark: a broken outer ring — a long green "C" and a short white
 * segment facing it — around a mint inner ring.
 *
 * Traced from the source artwork at src/assets/concord-logo-source.png, a 128px
 * raster. The white segment is easy to miss there, being white on white; it is
 * part of the mark, not a filled opening, and sits in the same ring band as the
 * "C" (both measure to mean radius 49.5, width 12.3) separated from it by a gap
 * at each end. This vector version reproduces the measured geometry: centre
 * 63.5, outer ring r49 w12 with the "C" from +56 deg to -56.5 deg and the
 * segment from +43.5 deg to -43.5 deg, inner ring r27.3 w12.5.
 */
interface Props {
  /** Rendered size in pixels; the mark is square. */
  size?: number;
  class?: string;
  /** Set when the mark is the only content of a link or button. */
  title?: string;
  /**
   * Draw the mark on load rather than painting it outright: the inner ring and
   * the "C" ink themselves in, the "C" carries on across the gap into the white
   * segment, a halo crosses the lot, and a ring of light leaves. See the
   * `.cx-mark-*` block in global.css. Hero lockup only — the nav and footer
   * marks are furniture and stay still.
   */
  animate?: boolean;
}

const { size = 28, class: className = '', title, animate = false } = Astro.props;

/*
 * The geometry, hoisted: when animating, a second copy of both shapes sits
 * underneath as the halo layer, and it has to trace the same mark exactly.
 */
const OUTER = 'M 90.90 22.88 A 49 49 0 1 0 90.54 104.36';
/* Authored from its *lower* terminal so that drawing the dash forward sweeps
   it counter-clockwise — the same way round as the "C", and starting where the
   "C" leaves off, which is what lets the entrance draw the two as one stroke. */
const SEGMENT = 'M 99.04 97.23 A 49 49 0 0 0 99.04 29.77';
const INNER = { cx: '63.5', cy: '63.5', r: '27.3' };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 128 128"
  fill="none"
  class:list={[animate && 'cx-mark', className]}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  {
    animate && (
      <>
        {/*
          The halo. A copy of the mark carrying a *static* drop-shadow, whose
          opacity is what animates: an animated filter re-runs the blur every
          frame, whereas fading a filter rasterized once is compositor-only.
          Only the glow shows, since the solid strokes sit directly on top.
        */}
        <g class="cx-mark-breathe">
          <g class="cx-mark-glow cx-mark-flash">
            <circle {...INNER} stroke="#5AFDB2" stroke-width="12.5" />
            <path d={OUTER} stroke="#1DA57A" stroke-width="12" />
            <path d={SEGMENT} stroke="#FFFFFF" stroke-width="12" />
          </g>
        </g>
        {/* One ring of light leaving the mark as it lands. */}
        <circle
          cx="63.5"
          cy="63.5"
          r="49"
          stroke="#24e8a3"
          stroke-width="2"
          class="cx-mark-wave"
        />
      </>
    )
  }

  {/*
    `pathLength="1"` puts the dash pattern in normalized units, so one set of
    keyframes draws both shapes regardless of their real perimeters.
  */}
  <circle
    {...INNER}
    fill="none"
    stroke="#5AFDB2"
    stroke-width="12.5"
    pathLength={animate ? '1' : undefined}
    class:list={[animate && 'cx-mark-stroke cx-mark-stroke-inner']}
  />
  <path
    d={OUTER}
    fill="none"
    stroke="#1DA57A"
    stroke-width="12"
    pathLength={animate ? '1' : undefined}
    class:list={[animate && 'cx-mark-stroke']}
  />
  <path
    d={SEGMENT}
    fill="none"
    stroke="#FFFFFF"
    stroke-width="12"
    pathLength={animate ? '1' : undefined}
    class:list={[animate && 'cx-mark-stroke cx-mark-stroke-segment']}
  />
</svg>

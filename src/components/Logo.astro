---
/**
 * The Concord mark: an open "C" ring with a mint inner ring.
 *
 * Traced from the source artwork at src/assets/concord-logo-source.png, which
 * is a 128px raster whose "C" opening is filled with *opaque white* rather than
 * transparency — invisible on a white page, a glaring white crescent on this
 * site's black. This vector version reproduces the measured geometry (centre
 * 63.5, outer ring r49 w12, inner ring r27.3 w12.5, opening from +56 deg to
 * -56.5 deg) with a genuinely transparent opening, and stays crisp at the small
 * sizes the nav and favicon need.
 */
interface Props {
  /** Rendered size in pixels; the mark is square. */
  size?: number;
  class?: string;
  /** Set when the mark is the only content of a link or button. */
  title?: string;
}

const { size = 28, class: className = '', title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 128 128"
  fill="none"
  class={className}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  <circle
    cx="63.5"
    cy="63.5"
    r="27.3"
    fill="none"
    stroke="#5AFDB2"
    stroke-width="12.5"
  />
  <path
    d="M 90.90 22.88 A 49 49 0 1 0 90.54 104.36"
    fill="none"
    stroke="#1DA57A"
    stroke-width="12"
  />
</svg>

---
/*
 * The site footer. `compact` drops the link columns, for the docs, where the
 * sidebar already lists every page.
 */
import Brand from './Brand.astro';
import { SPEC_REPO } from '../data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const columns = [
  {
    title: 'Learn',
    links: [
      { label: 'What is Concord?', href: '/learn/what-is-concord/' },
      { label: 'How it works', href: '/learn/how-it-works/' },
      { label: 'What a relay sees', href: '/learn/what-a-relay-sees/' },
      { label: 'Threat model', href: '/learn/threat-model/' },
      { label: 'Compared to alternatives', href: '/learn/comparison/' },
    ],
  },
  {
    title: 'Specification',
    links: [
      { label: 'All CORD documents', href: '/spec/' },
      { label: 'Event examples', href: '/spec/examples/' },
      { label: 'Implementer checklist', href: '/build/checklist/' },
      { label: 'Glossary', href: '/learn/glossary/' },
    ],
  },
  {
    title: 'Ecosystem',
    links: [
      { label: 'Clients', href: '/clients/' },
      { label: 'Build on Concord', href: '/build/' },
      { label: 'SDKs and libraries', href: '/build/sdks/' },
      { label: 'Bots', href: '/build/bots/' },
    ],
  },
];
---

<footer
  class:list={[
    'border-t border-hairline',
    compact ? 'mt-16 pt-10' : 'bg-black',
  ]}
>
  <div class:list={[!compact && 'mx-auto max-w-6xl px-5 py-16']}>
    <div class:list={['grid gap-12', !compact && 'md:grid-cols-[1.4fr_repeat(3,1fr)]']}>
      <div>
        <Brand />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-gray-400">
          End-to-end encrypted communities and channels, built on open
          infrastructure. No company, no central server, no intermediary.
        </p>
        <p class="mt-6 font-mono text-xs text-gray-500">
          Specification MIT &middot; site CC BY-SA 4.0
        </p>
      </div>

      {
        !compact &&
          columns.map((column) => (
            <div>
              <h2 class="text-sm font-semibold text-gray-100">{column.title}</h2>
              <ul class="mt-4 space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-gray-400 transition-colors hover:text-mint"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
      }
    </div>

    <div
      class:list={[
        'flex flex-col gap-4 border-t border-hairline sm:flex-row sm:items-center sm:justify-between',
        compact ? 'mt-10 pt-6' : 'mt-14 pt-8',
      ]}
    >
      <p class="font-mono text-xs text-gray-500">
        Concord is an evolving specification. Contributions and review are
        welcome.
      </p>
      <div class="flex shrink-0 gap-5">
        <a
          href={SPEC_REPO}
          rel="noopener"
          class="text-sm text-gray-400 no-underline transition-colors hover:text-mint"
        >
          Specification repository
        </a>
        <a
          href="https://github.com/nostr-protocol/nostr"
          rel="noopener"
          class="text-sm text-gray-400 no-underline transition-colors hover:text-mint"
        >
          Nostr
        </a>
      </div>
    </div>
  </div>
</footer>

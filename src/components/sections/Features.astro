---
/*
 * Eight cards is a lot of surface, so each one gets a glyph and one sentence.
 * The icons are raw path data on a shared 24px, stroked, currentColor frame —
 * the alternative was an icon dependency for eight shapes.
 */
const features = [
  {
    title: 'Communities and channels',
    body: 'One membership over any number of rooms. A private channel leaks only itself.',
    icon: '<path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/>',
    spec: 'CORD-02 · CORD-03',
    href: '/concepts/channels/',
  },
  {
    title: 'Roles that verify themselves',
    body: 'Admin, mod, or anything you define. Every client folds the chain and reaches the same verdict.',
    icon: '<path d="M12 3 4 6.2v5.4c0 4.6 3.4 8.4 8 9.4 4.6-1 8-4.8 8-9.4V6.2Z"/><path d="m8.8 12.2 2.2 2.2 4.2-4.4"/>',
    spec: 'CORD-04',
    href: '/concepts/roles/',
  },
  {
    title: 'Invites that revoke',
    body: 'A link carries a locator, not a key. Retire it and the coordinate becomes a tombstone.',
    icon: '<path d="M10.5 13.5a4.5 4.5 0 0 0 6.4 0l2.4-2.4a4.5 4.5 0 0 0-6.4-6.4l-1.3 1.3"/><path d="M13.5 10.5a4.5 4.5 0 0 0-6.4 0l-2.4 2.4a4.5 4.5 0 0 0 6.4 6.4l1.3-1.3"/>',
    spec: 'CORD-05',
    href: '/concepts/invites/',
  },
  {
    title: 'Removal that actually removes',
    body: 'Ban silences instantly. Then the room rolls to a key the removed member never gets.',
    icon: '<path d="M20.5 12a8.5 8.5 0 1 1-2.6-6.1"/><path d="M20.5 4.2v4.6h-4.6"/>',
    spec: 'CORD-06',
    href: '/concepts/removal/',
  },
  {
    title: 'Voice, video, and screenshare',
    body: 'Any channel is callable. The broker never learns which community it serves; the SFU forwards ciphertext.',
    icon: '<path d="M3.5 10v4M8 6.5v11M12 3.5v17M16 6.5v11M20.5 10v4"/>',
    spec: 'CORD-07',
    href: '/concepts/voice/',
  },
  {
    title: 'Disappearing messages',
    body: 'One staff-set timer. Expired messages are purged locally and deleted from relays.',
    icon: '<path d="M12 21.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17Z"/><path d="M12 8.8V13l2.8 2"/><path d="M9 2.5h6"/>',
    spec: 'CORD-08',
    href: '/concepts/disappearing-messages/',
  },
  {
    title: 'Pins that carry proof',
    body: 'A pin does not quote a message, it proves one — and it survives every rotation.',
    icon: '<path d="M12 16.5V22"/><path d="M8.5 2.5h7l-1.2 6.4 3 3.1v2H6.7v-2l3-3.1Z"/>',
    spec: 'CORD-04 §7',
    href: '/spec/cord-04/',
  },
  {
    title: 'Your memberships, everywhere',
    body: 'A self-encrypted list syncs your rooms across devices, and across clients.',
    icon: '<path d="M3 5.5h11v9H3z"/><path d="M6 18.5h5M8.5 14.5v4"/><path d="M16.5 9.5h4.5v11h-4.5z"/>',
    spec: 'CORD-02 §8',
    href: '/spec/cord-02/',
  },
];
---

<section class="border-b border-hairline">
  <div class="mx-auto max-w-6xl px-5 py-24">
    <p class="cx-eyebrow">Capabilities</p>
    <h2
      class="mt-4 max-w-3xl text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
    >
      Everything a community needs, and nothing that needs a host.
    </h2>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((feature) => (
          <a href={feature.href} class="cx-card cx-card-link group flex flex-col p-6">
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-mint"
              aria-hidden="true"
              set:html={feature.icon}
            />

            <h3 class="mt-5 text-base font-semibold leading-snug text-white">
              {feature.title}
            </h3>
            <p class="mt-2.5 flex-1 text-sm leading-relaxed text-gray-400">
              {feature.body}
            </p>
            <p class="mt-5 font-mono text-[0.65rem] uppercase tracking-wider text-gray-600 transition-colors group-hover:text-mint">
              {feature.spec}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>

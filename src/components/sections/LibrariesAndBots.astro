---
/*
 * What else is running on the protocol, at the foot of the clients page: the
 * same list of things you can install, one step further from the end user.
 *
 * One grid, not two. The libraries and the bots used to be drawn as separate
 * blocks at different weights — a full-width row for the library, thirds for
 * the bots — under their own labelled subheadings. That hierarchy was doing
 * work on a homepage section that had to be skimmed in passing; here the page
 * is already a list of things to install, and a second and third way of
 * ranking them only slows it down. Every tool now gets the same card, and the
 * icon on each one says which sort it is.
 *
 * Libraries come first because the icons then arrive in groups rather than
 * shuffled, which is the whole of what the old subheadings were for.
 *
 * `Private Events` is in TOOLS and deliberately not here: it is an application
 * built on Concord rather than a library or a bot, and it keeps its place in
 * the build section on that page.
 */
import { TOOLS } from '../../data/site';

/* A crate: the thing you add to a manifest. */
const LIBRARY_ICON = [
  'M12 3 3 7.5v9L12 21l9-4.5v-9L12 3Z',
  'm3 7.5 9 4.5 9-4.5',
  'M12 12v9',
];

/* A head with an antenna, two eyes, and a pair of ears. `h.01` with a round
   linecap is how the eyes are drawn as dots without a second stroke rule. */
const BOT_ICON = [
  'M8.5 7h7A2.5 2.5 0 0 1 18 9.5v6a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 6 15.5v-6A2.5 2.5 0 0 1 8.5 7Z',
  'M12 4.5V7',
  'M12 3.2h.01',
  'M9.5 11.5h.01',
  'M14.5 11.5h.01',
  'M10 14.75h4',
  'M3.5 11.5v2',
  'M20.5 11.5v2',
];

const isLibrary = (kind: string) => kind === 'SDK' || kind === 'Library';

/*
 * Each card's links, in the shape the client cards above them use: the way in
 * first, anything else after it. A library is fetched from a registry and so
 * says "Get"; a bot's only address is its repository, so it says what it is.
 */
const tools = TOOLS.filter(
  (tool) => isLibrary(tool.kind) || tool.kind === 'Bot',
)
  .map((tool) => ({
    ...tool,
    library: isLibrary(tool.kind),
    links: [
      {
        label: isLibrary(tool.kind) ? `Get ${tool.name}` : 'Source',
        href: tool.href,
      },
      ...(tool.docs ? [{ label: 'Docs', href: tool.docs }] : []),
    ],
  }))
  .sort((a, b) => Number(b.library) - Number(a.library));
---

<section class="border-t border-hairline">
  <div class="mx-auto max-w-6xl px-5 py-20">
    <p class="cx-eyebrow">Ecosystem</p>
    <h2
      class="mt-4 text-balance text-2xl font-semibold leading-tight tracking-tight text-white sm:text-3xl"
    >
      Libraries &amp; bots.
    </h2>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((tool) => (
          <li>
            <article class="cx-card flex h-full flex-col p-6">
              <div class="flex items-center gap-2.5">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-[18px] w-[18px] shrink-0 text-mint"
                  aria-hidden="true"
                >
                  {(tool.library ? LIBRARY_ICON : BOT_ICON).map((d) => (
                    <path d={d} />
                  ))}
                </svg>
                <h3 class="truncate font-mono text-sm font-semibold text-white">
                  {tool.name}
                </h3>
              </div>

              <p class="mt-1.5 font-mono text-[0.65rem] text-gray-500">
                by {tool.author} &middot; {tool.language}
              </p>

              <p class="mt-3 text-xs leading-relaxed text-gray-400">
                {tool.description}
              </p>

              {/* Pushed to a common baseline, so a card with two links does
                  not stand taller than the ones beside it. */}
              <div class="mt-auto flex flex-wrap gap-x-4 gap-y-2 pt-6">
                {tool.links.map((link) => (
                  <a
                    href={link.href}
                    rel="noopener"
                    class="text-sm text-gray-400 transition-colors hover:text-gray-100"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <a
      href="/build/"
      class="mt-12 inline-flex text-sm text-mint transition-opacity hover:opacity-80"
    >
      Build your own &rarr;
    </a>
  </div>
</section>

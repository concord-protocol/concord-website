---
/*
 * One group of TOOLS per call. Bridges render as highlighted cards; bots,
 * libraries, and apps render as ruled rows. The caller supplies the heading.
 */
import { TOOLS } from '../../data/site';
import Discord from '../../assets/icons/discord.svg';
import Matrix from '../../assets/icons/matrix.svg';

/* Each network's mark (Simple Icons, CC0), drawn in one colour. */
const NETWORKS = { discord: Discord, matrix: Matrix } as const;

/* Two arrows passing each other: traffic both ways. */
const BRIDGE_ICON = ['M4 8h13', 'm13 4 4 4-4 4', 'M20 16H7', 'm11 12-4 4 4 4'];

interface Props {
  group: 'bridges' | 'bots' | 'libraries' | 'apps';
}

const { group } = Astro.props;

const KINDS: Record<Props['group'], string[]> = {
  bridges: ['Bridge'],
  bots: ['Bot'],
  libraries: ['SDK', 'Library'],
  apps: ['App'],
};

const tools = TOOLS.filter((tool) => KINDS[group].includes(tool.kind));

/* A crate. */
const LIBRARY_ICON = [
  'M12 3 3 7.5v9L12 21l9-4.5v-9L12 3Z',
  'm3 7.5 9 4.5 9-4.5',
  'M12 12v9',
];

/* A robot head. `h.01` with a round linecap draws the eyes as dots. */
const BOT_ICON = [
  'M8.5 7h7A2.5 2.5 0 0 1 18 9.5v6a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 6 15.5v-6A2.5 2.5 0 0 1 8.5 7Z',
  'M12 4.5V7',
  'M12 3.2h.01',
  'M9.5 11.5h.01',
  'M14.5 11.5h.01',
  'M10 14.75h4',
  'M3.5 11.5v2',
  'M20.5 11.5v2',
];

/* An app window. */
const APP_ICON = ['M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z', 'M3 9h18', 'M6 7h.01', 'M8.5 7h.01'];

/* A magnifying glass. */
const SEARCH_ICON = ['M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13Z', 'm15.5 15.5 5 5'];

/* GitWorkshop's search matches names, descriptions, and `t` tags. */
const MORE = 'https://gitworkshop.dev/search?q=concord';

const icon = { libraries: LIBRARY_ICON, apps: APP_ICON }[group as string] ?? BOT_ICON;
---

{group === 'bridges' && (
  <ul class="grid gap-4 md:grid-cols-2">
    {tools.map((tool) => (
      <li>
        <a
          href={tool.href}
          rel="noopener"
          class="cx-card cx-card-lit cx-card-link group flex h-full gap-5 p-6 sm:p-7"
        >
          {/* Two-way arrows plus the far network's mark. */}
          <span
            class="flex h-11 shrink-0 items-center gap-1.5 rounded-[13%] border border-mint/30 bg-mint/10 px-2.5 text-mint"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              {BRIDGE_ICON.map((d) => (
                <path d={d} />
              ))}
            </svg>
            {tool.network && (() => {
              const Mark = NETWORKS[tool.network];
              return <Mark width={18} height={18} />;
            })()}
          </span>
          <span class="min-w-0">
            <span class="block font-mono text-base font-semibold text-white transition-colors group-hover:text-mint">
              {tool.name}
            </span>
            <span class="mt-1 block font-mono text-[0.65rem] text-gray-500">
              {tool.author} &middot; {tool.language}
            </span>
            <span class="mt-3 block text-sm leading-relaxed text-gray-400">
              {tool.description}
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
)}

{/* Two columns of ruled rows; the whole row is the link. */}
{group !== 'bridges' && (
  <ul class="grid gap-x-12 border-b border-hairline sm:grid-cols-2">
    {
      tools.map((tool) => (
        <li class="border-t border-hairline">
          <a href={tool.href} rel="noopener" class="group flex gap-4 py-5">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-0.5 h-5 w-5 shrink-0 text-mint"
              aria-hidden="true"
            >
              {icon.map((d) => (
                <path d={d} />
              ))}
            </svg>
            <span class="min-w-0">
              <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-mono text-sm font-semibold text-white transition-colors group-hover:text-mint">
                  {tool.name}
                </span>
                <span class="font-mono text-[0.65rem] text-gray-500">
                  {tool.author} &middot; {tool.language}
                </span>
              </span>
              <span class="mt-1.5 block text-sm leading-relaxed text-gray-400">
                {tool.description}
              </span>
            </span>
          </a>
        </li>
      ))
    }
    {/* Fills the empty cell an odd-length list leaves in the second column. */}
    {tools.length % 2 === 1 && (
      <li class="border-t border-hairline">
        <a href={MORE} rel="noopener" class="group flex gap-4 py-5">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mt-0.5 h-5 w-5 shrink-0 text-gray-500 transition-colors group-hover:text-mint"
            aria-hidden="true"
          >
            {SEARCH_ICON.map((d) => (
              <path d={d} />
            ))}
          </svg>
          <span class="min-w-0">
            <span class="font-mono text-sm font-semibold text-gray-300 transition-colors group-hover:text-mint">
              Find more on GitWorkshop &rarr;
            </span>
            <span class="mt-1.5 block text-sm leading-relaxed text-gray-400">
              Search Nostr-hosted repositories for Concord projects.
            </span>
          </span>
        </a>
      </li>
    )}
  </ul>
)}

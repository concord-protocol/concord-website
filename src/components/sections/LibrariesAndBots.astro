---
/*
 * What else is running on the protocol: no title and no section of its own —
 * just more rows of the same grid, at the same width and the same gap, so the
 * page reads as one list of things to install that gets smaller as it goes.
 * The rule that divides these from the client cards is drawn by the page, not
 * here, so nothing changes if this is ever dropped somewhere it isn't wanted.
 *
 * The two groups are drawn at different weights on purpose. A library is a
 * decision — you pick one and build on it — so it gets a full-width card with
 * room for its author, its language, and both of its links. A bot is a thing
 * you drop into a community and forget about, so three of them fit across the
 * same width. Size is the whole hierarchy here; nothing says "more important".
 *
 * Neither group is labelled, and the crate and the robot on the cards are the
 * only thing that says which is which — subheadings over groups this obviously
 * different were signposting a distinction the shapes already make. The icons
 * are drawn from shared path lists rather than pasted twice.
 *
 * `Private Events` is in TOOLS and deliberately not here: it is an application
 * built on Concord rather than a library or a bot, and it keeps its place in
 * the build section on that page.
 */
import { TOOLS } from '../../data/site';

const libraries = TOOLS.filter(
  (tool) => tool.kind === 'SDK' || tool.kind === 'Library',
);
const bots = TOOLS.filter((tool) => tool.kind === 'Bot');

/* A crate: the thing you add to a manifest. */
const LIBRARY_ICON = [
  'M12 3 3 7.5v9L12 21l9-4.5v-9L12 3Z',
  'm3 7.5 9 4.5 9-4.5',
  'M12 12v9',
];

/* A head with an antenna, two eyes, and a pair of ears. `h.01` with a round
   linecap is how the eyes are drawn as dots without a second stroke rule. */
const BOT_ICON = [
  'M8.5 7h7A2.5 2.5 0 0 1 18 9.5v6a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 6 15.5v-6A2.5 2.5 0 0 1 8.5 7Z',
  'M12 4.5V7',
  'M12 3.2h.01',
  'M9.5 11.5h.01',
  'M14.5 11.5h.01',
  'M10 14.75h4',
  'M3.5 11.5v2',
  'M20.5 11.5v2',
];
---

{/*
  `mt-4` twice, the gap the grid above uses, so each block lands where the
  next row of cards would have. One library today, so a grid would leave it
  stranded at half width; the column only appears once there is something to
  sit beside it.
*/}
<div class:list={['mt-4 grid gap-4', libraries.length > 1 && 'md:grid-cols-2']}>
  {
    libraries.map((library) => (
      <article class="cx-card flex flex-col gap-6 p-7 sm:flex-row sm:items-center sm:p-8">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-[13%] border border-hairline bg-raised">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-7 w-7 text-mint"
            aria-hidden="true"
          >
            {LIBRARY_ICON.map((d) => (
              <path d={d} />
            ))}
          </svg>
        </span>

        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="font-mono text-xl font-semibold tracking-tight text-white">
              {library.name}
            </h3>
            <p class="font-mono text-xs text-gray-500">
              by {library.author} &middot; {library.language}
            </p>
          </div>
          <p class="mt-3 text-balance text-sm leading-relaxed text-gray-400">
            {library.description}
          </p>
        </div>

        <div class="flex shrink-0 flex-wrap gap-2.5">
          <a href={library.href} rel="noopener" class="cx-btn cx-btn-ghost">
            Get {library.name}
          </a>
          {library.docs && (
            <a href={library.docs} rel="noopener" class="cx-btn cx-btn-ghost">
              Docs
            </a>
          )}
        </div>
      </article>
    ))
  }
</div>

{/* Three across at the gap the client cards use, so the bot cards sit in
    their columns rather than a hair off them. */}
<ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    bots.map((bot) => (
      <li>
        <a
          href={bot.href}
          rel="noopener"
          class="cx-card cx-card-link flex h-full flex-col p-5"
        >
          <span class="flex items-center gap-2.5">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-[18px] w-[18px] shrink-0 text-mint"
              aria-hidden="true"
            >
              {BOT_ICON.map((d) => (
                <path d={d} />
              ))}
            </svg>
            <span class="truncate font-mono text-sm font-semibold text-white">
              {bot.name}
            </span>
          </span>

          <span class="mt-1.5 block font-mono text-[0.65rem] text-gray-500">
            by {bot.author} &middot; {bot.language}
          </span>

          <span class="mt-3 block text-xs leading-relaxed text-gray-400">
            {bot.description}
          </span>
        </a>
      </li>
    ))
  }
</ul>

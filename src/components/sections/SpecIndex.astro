---
import { CORDS } from '../../data/site';
---

<section class="border-b border-hairline">
  <div class="mx-auto max-w-6xl px-5 py-24">
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <p class="cx-eyebrow">The specification</p>
        <h2
          class="mt-4 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
        >
          Eight documents. Read them all in an evening.
        </h2>
      </div>
      <a href="/spec/" class="cx-btn cx-btn-ghost shrink-0">
        Read the specification
      </a>
    </div>

    <ol class="mt-12 divide-y divide-hairline border-y border-hairline">
      {
        CORDS.map((cord) => (
          <li>
            <a
              href={`/spec/cord-${cord.id}/`}
              class="group flex flex-col gap-2 py-5 transition-colors hover:bg-mint/[0.03] sm:flex-row sm:items-center sm:gap-8 sm:px-2"
            >
              <span class="font-mono text-sm text-gray-600 transition-colors group-hover:text-mint sm:w-24 sm:shrink-0">
                CORD-{cord.id}
              </span>
              <span class="text-base font-medium text-white sm:w-64 sm:shrink-0">
                {cord.title}
              </span>
              <span class="flex-1 text-sm leading-relaxed text-gray-400">
                {cord.summary}
              </span>
              <span
                class="hidden text-gray-600 transition-all group-hover:translate-x-0.5 group-hover:text-mint sm:inline"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

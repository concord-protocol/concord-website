---
/*
 * Four paragraphs of caveats, as a matrix.
 *
 * Each column is a plain question with a plain answer, so the shape of the
 * comparison lands before any of it is read: the others each go dark somewhere,
 * and where they go dark is the whole point. The prose that used to say this
 * moved to /learn/comparison/, which is linked below.
 */
type Support = 'yes' | 'part' | 'no';

const columns = [
  'End-to-end encrypted',
  'No server to run',
  'Large rooms',
  'Roles & bans',
];

const rows: {
  name: string;
  subtitle: string;
  href?: string;
  builtFor: string;
  support: Support[];
  us?: boolean;
}[] = [
  {
    name: 'NIP-17',
    subtitle: 'Private DMs',
    href: 'https://github.com/nostr-protocol/nips/blob/master/17.md',
    builtFor: 'One-to-one messages',
    support: ['yes', 'yes', 'no', 'no'],
  },
  {
    name: 'NIP-29',
    subtitle: 'Relay-based groups',
    href: 'https://github.com/nostr-protocol/nips/blob/master/29.md',
    builtFor: 'Hosted group chat',
    /* Moderation is real, but the relay is the one enforcing it — which is
       exactly what the second column is asking about. */
    support: ['no', 'no', 'yes', 'yes'],
  },
  {
    name: 'Marmot',
    subtitle: 'MLS on Nostr',
    href: 'https://github.com/marmot-protocol/marmot',
    builtFor: 'Small, high-stakes groups',
    /* MLS scales, but in lockstep: ordered commits and per-device key packages
       are heavy for a large, casual, high-churn room. */
    support: ['yes', 'yes', 'part', 'no'],
  },
  {
    name: 'Iris Chat',
    subtitle: 'Double Ratchet chats',
    href: 'https://irischat.org/',
    builtFor: 'Pairwise ratcheted chat',
    support: ['yes', 'yes', 'no', 'no'],
  },
  {
    name: 'Concord',
    subtitle: 'Encrypted communities',
    builtFor: 'Large, high-churn communities',
    support: ['yes', 'yes', 'yes', 'yes'],
    us: true,
  },
];

const MARKS: Record<Support, { label: string; path: string; class: string }> = {
  yes: { label: 'Yes', path: 'm5 12.5 4.5 4.5L19 7.5', class: 'text-mint' },
  part: { label: 'Partly', path: 'M6 12h12', class: 'text-gray-400' },
  no: { label: 'No', path: 'M7 7l10 10M17 7 7 17', class: 'text-gray-600' },
};
---

<section class="border-b border-hairline">
  <div class="mx-auto max-w-6xl px-5 py-24">
    <p class="cx-eyebrow">Where it fits</p>
    <h2
      class="mt-4 max-w-3xl text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
    >
      Concord is not the only way to do private messaging on Nostr.
    </h2>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-gray-400">
      It is built for one shape the others do not target — large,
      Discord-style communities. Each of them is better at something Concord
      deliberately trades away.
    </p>

    <div class="mt-14 overflow-x-auto rounded-xl border border-hairline">
      <table class="w-full min-w-[44rem] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-hairline bg-raised">
            <th scope="col" class="px-5 py-4 font-semibold text-gray-100">
              Protocol
            </th>
            <th
              scope="col"
              class="hidden px-5 py-4 font-semibold text-gray-100 md:table-cell"
            >
              Built for
            </th>
            {
              columns.map((column) => (
                <th
                  scope="col"
                  class="w-28 px-3 py-4 text-center align-bottom text-xs font-semibold leading-tight text-gray-300"
                >
                  {column}
                </th>
              ))
            }
          </tr>
        </thead>

        <tbody>
          {
            rows.map((row) => (
              <tr
                class:list={[
                  'border-b border-hairline last:border-0',
                  row.us && 'bg-mint/[0.04]',
                ]}
              >
                <th scope="row" class="px-5 py-5 align-top font-medium">
                  {row.href ? (
                    <a
                      href={row.href}
                      rel="noopener"
                      class="text-gray-100 transition-colors hover:text-mint"
                    >
                      {row.name}
                    </a>
                  ) : (
                    <span class="text-mint">{row.name}</span>
                  )}
                  <span class="mt-1 block text-xs font-normal text-gray-500">
                    {row.subtitle}
                  </span>
                </th>

                <td
                  class:list={[
                    'hidden px-5 py-5 align-top md:table-cell',
                    row.us ? 'text-gray-300' : 'text-gray-400',
                  ]}
                >
                  {row.builtFor}
                </td>

                {row.support.map((support, i) => (
                  <td class="px-3 py-5 text-center align-middle">
                    <span class="sr-only">
                      {columns[i]}: {MARKS[support].label}
                    </span>
                    <svg
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class:list={['mx-auto', MARKS[support].class]}
                      aria-hidden="true"
                    >
                      <path d={MARKS[support].path} />
                    </svg>
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-1 font-mono text-[0.65rem] uppercase tracking-wider text-gray-600">
      <span><span class="text-mint">&check;</span> yes</span>
      <span><span class="text-gray-400">&mdash;</span> partly</span>
      <span><span class="text-gray-600">&times;</span> no</span>
      <a
        href="/learn/comparison/"
        class="normal-case tracking-normal text-mint transition-opacity hover:opacity-80"
        >Read the long version &rarr;</a
      >
    </p>
  </div>
</section>

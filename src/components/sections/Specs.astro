---
/*
 * The eight documents as eight tiles, in the same frame as the two sections
 * above it: outlined wordmark title, cards on a hairline, one link out at the
 * bottom.
 *
 * These go to the rendered pages under /spec/. The documents are synced into
 * the site, so there is no reason to hand someone off to a repository to read
 * something we already publish; the pages themselves say the repository is the
 * source of truth for anyone who needs the normative file.
 *
 * Number, title, one line. A card is a thing you scan a grid of, and the
 * summaries are already written short enough to survive a quarter-width column.
 */
import { CORDS } from '../../data/site';

/** Where a CORD is rendered on this site: `01` becomes `/spec/cord-01/`. */
const page = (id: string) => `/spec/cord-${id}/`;
---

<section class="border-b border-hairline">
  <div class="mx-auto max-w-5xl px-5 py-24">
    <h2 class="cx-outline-title text-center text-3xl sm:text-4xl">SPECS</h2>

    <ol class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        CORDS.map((cord) => (
          <li>
            <a
              href={page(cord.id)}
              class="cx-card cx-card-link flex h-full flex-col p-5"
            >
              <span class="font-mono text-xs text-mint">CORD-{cord.id}</span>

              <span class="mt-2.5 block text-sm font-medium leading-snug text-white">
                {cord.title}
              </span>

              <span class="mt-2 block text-xs leading-relaxed text-gray-400">
                {cord.summary}
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 text-center">
      <a
        href="/spec/"
        class="inline-flex text-sm text-mint transition-opacity hover:opacity-80"
      >
        The full specification &rarr;
      </a>
    </div>
  </div>
</section>

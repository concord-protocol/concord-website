---
/*
 * The eight documents as eight tiles, in the same frame as the two sections
 * above it: outlined wordmark title, cards on a hairline, one link out at the
 * bottom.
 *
 * These go to the repository rather than to /spec/, which is the one place on
 * the site where that is the right link. The synced pages carry a note saying
 * the repository is the source of truth and wins any disagreement, so a
 * homepage index that hands you the normative file is being literal, not
 * sending you away. The footer link is the route to the rendered version for
 * anyone who would rather read it here.
 *
 * Number, title, one line. A card is a thing you scan a grid of, and the
 * summaries are already written short enough to survive a quarter-width column.
 */
import { CORDS, SPEC_REPO } from '../../data/site';

/** Where a CORD lives upstream: `01.md` at the root of the spec repository. */
const source = (id: string) => `${SPEC_REPO}/blob/main/${id}.md`;
---

<section class="border-b border-hairline">
  <div class="mx-auto max-w-5xl px-5 py-24">
    <h2 class="cx-outline-title text-center text-3xl sm:text-4xl">SPECS</h2>

    <ol class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        CORDS.map((cord) => (
          <li>
            <a
              href={source(cord.id)}
              rel="noopener"
              class="cx-card cx-card-link group flex h-full flex-col p-5"
            >
              <span class="flex items-center justify-between gap-2">
                <span class="font-mono text-xs text-mint">CORD-{cord.id}</span>
                {/*
                  The mark, muted until the card is under the cursor: it is
                  saying where the link goes, which is worth one glyph and not
                  worth a row of colour across eight tiles.
                */}
                <svg
                  viewBox="0 0 16 16"
                  fill="currentColor"
                  class="h-3.5 w-3.5 shrink-0 text-gray-600 transition-colors group-hover:text-mint"
                  aria-hidden="true"
                >
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                </svg>
              </span>

              <span class="mt-2.5 block text-sm font-medium leading-snug text-white">
                {cord.title}
              </span>

              <span class="mt-2 block text-xs leading-relaxed text-gray-400">
                {cord.summary}
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 text-center">
      <a
        href="/spec/"
        class="inline-flex text-sm text-mint transition-opacity hover:opacity-80"
      >
        Read them here &rarr;
      </a>
    </div>
  </div>
</section>

---
/*
 * Two apps, side by side, immediately under the hero — the first thing after
 * "private communities, open protocol" is what to press.
 *
 * The order and the weight are saying different things on purpose. Vector goes
 * first because the protocol was written there, and the card says so in one
 * line and then gets out of the way. Armada goes second and carries the only
 * filled button on the screen, so the choice is made by the shape of the two
 * cards rather than by any sentence claiming one is better.
 *
 * A bare title and no eyebrow: "Try an App" is an instruction, and the two
 * icons under it are the whole argument, so there is nothing for a standfirst
 * paragraph to add that the cards do not already say.
 *
 * The logos are the apps' own icons rather than redrawn marks, at their
 * shipped sizes.
 */
import { Image } from 'astro:assets';
import { CLIENTS } from '../../data/site';
import LinkIcon from '../LinkIcon.astro';

/** The entry in {@link CLIENTS}, which owns every outbound URL on the site. */
function client(name: string) {
  const match = CLIENTS.find((entry) => entry.name === name);
  if (!match) throw new Error(`Apps.astro: no client named ${name} in site.ts`);
  return match;
}

const vector = client('Vector');
const armada = client('Armada');

/** Listings that install and update the app, as opposed to files to download. */
const STORE_ICONS = new Set(['google-play', 'fdroid', 'zapstore']);

/*
 * The cards, in the clients page's dress: lit in each app's own colour, with
 * stores and downloads as mono marks under one-word labels instead of a strip
 * of platform chips. The marks name every platform the chips did, and each one
 * is also a link to it.
 *
 * The recommendation stays where it was. Armada has the filled button, Vector
 * a ghost one; the glow is not a ranking, since every app on the site has one.
 */
const CARDS = [
  {
    client: vector,
    byline: 'by JSKitty',
    line: 'Private messaging with no phone number and no email. Concord started here.',
    primary: false,
  },
  {
    client: armada,
    byline: 'by Soapbox',
    line: 'Everything you use Discord for, from voice rooms to roles, with nobody in the middle.',
    primary: true,
  },
].map((card) => {
  const rest = card.client.links.slice(1);
  return {
    ...card,
    groups: [
      { label: 'Stores', links: rest.filter((l) => l.icon && STORE_ICONS.has(l.icon)) },
      { label: 'Downloads', links: rest.filter((l) => l.icon && !STORE_ICONS.has(l.icon)) },
    ].filter((group) => group.links.length > 0),
    /* The page of every build, after the marks: "All" beside the systems. */
    all: rest.find((l) => !l.icon && l.label === 'Downloads'),
  };
});
---

<section class="overflow-hidden border-b border-hairline">
  <div class="mx-auto max-w-5xl px-5 py-24">
    {/*
      The hero's lockup, quietened and reused: same face, same mint outline,
      same bloom, centred over the pair the way the wordmark is centred over
      the mark. One word can carry it — Bruno Ace outlined is unreadable at
      paragraph length and unmistakable at four letters — and it is set well
      below the hero's size so the page still has one title.
    */}
    <h2 class="cx-outline-title text-center text-3xl sm:text-4xl">APPS</h2>

    {/*
      Stretched to a common height, with each card's button pushed to the
      bottom by `mt-auto`, so the two buttons sit on one line however much
      each card has to say.
    */}
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {
        CARDS.map(({ client, byline, line, primary, groups, all }, i) => (
          <article
            class="cx-app flex flex-col p-7 sm:p-8"
            style={`--glow: ${client.glow}`}
          >
            {/*
              The hover field (see app-noise.ts). Side by side, each card
              spills only outward, so neither paints over the other.
            */}
            <canvas
              class:list={[
                'cx-app-noise',
                i === 0 ? 'md:[--spill-right:0px]' : 'md:[--spill-left:0px]',
              ]}
              aria-hidden="true"
            />

            <div class="flex items-center gap-4">
              {/*
                Rounded to roughly the radius Vector's icon already carries in
                its own artwork, so the two marks sit as a matched pair.
                `alt=""`: the name is right beside it in the heading.
              */}
              <Image
                src={client.logo}
                alt=""
                width={56}
                height={56}
                densities={[2]}
                class="cx-app-logo h-14 w-14 shrink-0 rounded-[13%]"
              />
              <div class="min-w-0">
                <h2 class="text-2xl font-semibold tracking-tight text-white">
                  {client.name}
                </h2>
                <p class="mt-1 font-mono text-xs text-gray-500">{byline}</p>
              </div>
            </div>

            <p class="mt-6 text-balance text-sm leading-relaxed text-gray-400">
              {line}
            </p>

            <div class="mt-6 flex flex-wrap gap-x-8 gap-y-4">
              {groups.map((group) => (
                <div>
                  <p class="cx-eyebrow cx-eyebrow-muted mb-1.5 text-[0.6rem] leading-4">
                    {group.label}
                  </p>
                  <ul class="-ml-1.5 flex flex-wrap">
                    {group.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          rel="noopener"
                          title={link.label}
                          aria-label={`${client.name}: ${link.label}`}
                          class="grid h-8 w-8 place-items-center text-gray-300 transition-colors hover:text-white"
                        >
                          <LinkIcon icon={link.icon!} size={18} />
                        </a>
                      </li>
                    ))}
                    {group.label === 'Downloads' && all && (
                      <li>
                        <a
                          href={all.href}
                          rel="noopener"
                          class="ml-1.5 inline-flex h-8 items-center text-sm text-gray-400 transition-colors hover:text-white"
                        >
                          All &rarr;
                        </a>
                      </li>
                    )}
                  </ul>
                </div>
              ))}
            </div>

            <div class="mt-auto pt-8">
              <a
                href={client.href}
                rel="noopener"
                class:list={['cx-btn w-full', primary ? 'cx-btn-primary' : 'cx-btn-ghost border-white/20!']}
              >
                {client.links[0].label}
              </a>
            </div>
          </article>
        ))
      }
    </div>

    {/*
      The pair above is a recommendation rather than the whole list. Not "all
      three": the count is a fact about this week, and an open protocol that
      advertises how many clients exist is quietly saying that is the number
      there is meant to be.
    */}
    <div class="mt-10 text-center">
      <a
        href="/clients/"
        class="inline-flex text-sm text-mint transition-opacity hover:opacity-80"
      >
        See all &rarr;
      </a>
    </div>
  </div>
</section>

<script>
  import '../../scripts/app-noise';
</script>

---
/*
 * Two apps, side by side, immediately under the hero — the first thing after
 * "private communities, open protocol" is what to press.
 *
 * The order and the weight are saying different things on purpose. Vector goes
 * first because the protocol was written there, and the card says so in one
 * line and then gets out of the way. Armada goes second and carries the store
 * marks, the longer platform strip, and the only filled button on the screen,
 * so the choice is made by the shape of the two cards rather than by any
 * sentence claiming one is better. Nothing here ranks them out loud.
 *
 * A bare title and no eyebrow: "Try an App" is an instruction, and the two
 * icons under it are the whole argument, so there is nothing for a standfirst
 * paragraph to add that the cards do not already say.
 *
 * The logos are the apps' own icons rather than redrawn marks, at their
 * shipped sizes — see the note on the store marks below, which applies twice
 * over to somebody else's app icon.
 */
import { Image } from 'astro:assets';
import { CLIENTS } from '../../data/site';
import zapstoreMark from '../../assets/stores/zapstore.png';

/** The entry in {@link CLIENTS}, which owns every outbound URL on the site. */
function client(name: string) {
  const match = CLIENTS.find((entry) => entry.name === name);
  if (!match) throw new Error(`Apps.astro: no client named ${name} in site.ts`);
  return match;
}

const vector = client('Vector');
const armada = client('Armada');

/*
 * Where an Android user gets Armada without sideloading, mirroring the pair on
 * Armada's own landing page. Both are listings rather than files, so they are
 * the only install links here that are not simply `client.href`.
 *
 * There is no App Store button because there is no App Store build yet: the
 * first iOS version is still in review. iOS users get the web app, which is
 * what the "Web" chip is doing in the platform strip.
 */
const STORES = [
  {
    label: 'Google Play',
    href: 'https://play.google.com/store/apps/details?id=buzz.armada.app',
  },
  { label: 'Zapstore', href: 'https://zapstore.dev/apps/buzz.armada.app' },
];
---

<section class="border-b border-hairline">
  <div class="mx-auto max-w-5xl px-5 py-24">
    {/*
      The hero's lockup, quietened and reused: same face, same mint outline,
      same bloom, centred over the pair the way the wordmark is centred over
      the mark. One word can carry it — Bruno Ace outlined is unreadable at
      paragraph length and unmistakable at four letters — and it is set well
      below the hero's size so the page still has one title.
    */}
    <h2 class="cx-outline-title text-center text-3xl sm:text-4xl">APPS</h2>

    {/*
      Stretched to a common height, with each card's buttons pushed to the
      bottom by `mt-auto`. Armada carries a second row of them, so the two
      cards sized to their own content differ by a button's height and sit
      visibly mismatched; a shared baseline is the calmer read, and it lines
      the primary button up with the store row beside it.
    */}
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      <article class="cx-card flex flex-col p-7 sm:p-8">
        <div class="flex items-center gap-4">
          {/*
            Rounded to roughly the radius Vector's icon already carries in its
            own artwork, so the two marks sit as a matched pair — Armada's is a
            square canvas, and clipping it here is cheaper than shipping a
            second copy of somebody else's icon. A percentage keeps that true
            at whatever size the box ends up.

            `alt=""`: the name is right beside it in the heading, so a label
            here would have a screen reader say "Vector" twice.
          */}
          <Image
            src={vector.logo}
            alt=""
            width={56}
            height={56}
            densities={[2]}
            class="h-14 w-14 shrink-0 rounded-[13%]"
          />
          <div class="min-w-0">
            <h2 class="text-2xl font-semibold tracking-tight text-white">
              Vector
            </h2>
            <p class="mt-1 font-mono text-xs text-gray-500">by JSKitty</p>
          </div>
        </div>

        <p class="mt-6 text-balance text-sm leading-relaxed text-gray-400">
          Wrote the first Concord, and the first client for it.
        </p>

        <ul class="mt-6 flex flex-wrap gap-1.5">
          {
            vector.platforms.map((platform) => (
              <li class="rounded-md border border-hairline px-2 py-1 font-mono text-[0.65rem] text-gray-400">
                {platform}
              </li>
            ))
          }
        </ul>

        <div class="mt-auto pt-8">
          <a href={vector.href} rel="noopener" class="cx-btn cx-btn-ghost">
            Download Vector
          </a>
        </div>
      </article>

      <article class="cx-card cx-card-lit flex flex-col p-7 sm:p-8">
        <div class="flex items-center gap-4">
          <Image
            src={armada.logo}
            alt=""
            width={56}
            height={56}
            densities={[2]}
            class="h-14 w-14 shrink-0 rounded-[13%]"
          />
          <div class="min-w-0">
            <h2 class="text-2xl font-semibold tracking-tight text-white">
              Armada
            </h2>
            <p class="mt-1 font-mono text-xs text-gray-500">by Soapbox</p>
          </div>
        </div>

        {/*
          A list where Vector gets a sentence. It is the same argument the two
          cards are making everywhere else — one of them has more in it — and a
          run of nouns carries it without a word of comparison.
        */}
        <p class="mt-6 text-balance text-sm leading-relaxed text-gray-400">
          Channels, threads, roles, voice, video, custom emoji, Discord bridge.
        </p>

        <ul class="mt-6 flex flex-wrap gap-1.5">
          {
            armada.platforms.map((platform) => (
              <li class="rounded-md border border-hairline px-2 py-1 font-mono text-[0.65rem] text-gray-400">
                {platform}
              </li>
            ))
          }
        </ul>

        {/*
          Its own row, above the stores rather than beside them: three buttons
          wrap unpredictably inside half a card, and the filled one is the
          answer for everyone the two Android stores do not cover.
        */}
        <div class="mt-auto pt-8">
          <a href={armada.href} rel="noopener" class="cx-btn cx-btn-primary">
            Open Armada
          </a>
        </div>

        <div class="mt-3 flex flex-wrap gap-2.5">
          {
            STORES.map((store) => (
              <a
                href={store.href}
                rel="noopener"
                class="cx-btn cx-btn-ghost"
                aria-label={`Get Armada on ${store.label}`}
              >
                {/*
                  Each store's own mark, in its own colours: it is the thing
                  being scanned for on the page, and neither logo is ours to
                  redraw or to tint mint.
                */}
                {store.label === 'Google Play' ? (
                  <svg
                    viewBox="30 336.7 120.9 129.2"
                    width="17"
                    height="17"
                    class="shrink-0"
                    aria-hidden="true"
                  >
                    <path
                      fill="#FFD400"
                      d="M119.2,421.2c15.3-8.4,27-14.8,28-15.3c3.2-1.7,6.5-6.2,0-9.7c-2.1-1.1-13.4-7.3-28-15.3l-20.1,20.2L119.2,421.2z"
                    />
                    <path
                      fill="#F33"
                      d="M99.1,401.1l-64.2,64.7c1.5,0.2,3.2-0.2,5.2-1.3c4.2-2.3,48.8-26.7,79.1-43.3L99.1,401.1L99.1,401.1z"
                    />
                    <path
                      fill="#48FF48"
                      d="M99.1,401.1l20.1-20.2c0,0-74.6-40.7-79.1-43.1c-1.7-1-3.6-1.3-5.3-1L99.1,401.1z"
                    />
                    <path
                      fill="#3BCCFF"
                      d="M99.1,401.1l-64.3-64.3c-2.6,0.6-4.8,2.9-4.8,7.6c0,7.5,0,107.5,0,113.8c0,4.3,1.7,7.4,4.9,7.7L99.1,401.1z"
                    />
                  </svg>
                ) : (
                  <Image
                    src={zapstoreMark}
                    alt=""
                    width={17}
                    height={17}
                    densities={[2]}
                    class="shrink-0"
                  />
                )}
                {store.label}
              </a>
            ))
          }
        </div>
      </article>
    </div>

    {/*
      The pair above is a recommendation rather than the whole list. Not "all
      three": the count is a fact about this week, and an open protocol that
      advertises how many clients exist is quietly saying that is the number
      there is meant to be.
    */}
    <div class="mt-10 text-center">
      <a
        href="/clients/"
        class="inline-flex text-sm text-mint transition-opacity hover:opacity-80"
      >
        See all &rarr;
      </a>
    </div>
  </div>
</section>

---
import { TOOLS } from '../../data/site';

const snippet = `[dependencies]
vector_sdk = "0.8"`;
---

<section class="border-b border-hairline">
  <div class="mx-auto max-w-6xl px-5 py-24">
    <div class="grid gap-14 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
      <div>
        <p class="cx-eyebrow">Build on it</p>
        <h2
          class="mt-4 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
        >
          Bots are members, not integrations.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-gray-400">
          No API access to apply for, no webhook to register. A bot holds a key
          like anyone else, and nothing here privileges a human over a program.
        </p>

        <div class="mt-8 rounded-xl border border-hairline bg-raised p-5">
          <p class="font-mono text-[0.65rem] uppercase tracking-wider text-gray-500">
            Cargo.toml
          </p>
          <pre
            class="mt-3 overflow-x-auto font-mono text-sm leading-relaxed text-mint-soft"><code>{snippet}</code></pre>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/build/" class="cx-btn cx-btn-primary">Start building</a>
          <a href="/build/checklist/" class="cx-btn cx-btn-ghost">
            Implementer checklist
          </a>
        </div>
      </div>

      <ul class="space-y-3">
        {
          TOOLS.map((tool) => (
            <li>
              <a
                href={tool.href}
                rel="noopener"
                class="cx-card cx-card-link group flex items-start gap-5 p-5"
              >
                <span class="mt-0.5 shrink-0 rounded-md border border-hairline px-2 py-1 font-mono text-[0.65rem] uppercase tracking-wider text-mint">
                  {tool.kind}
                </span>

                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-baseline gap-x-2.5">
                    <span class="font-mono text-sm font-semibold text-white">
                      {tool.name}
                    </span>
                    <span class="text-xs text-gray-500">
                      {tool.language} &middot; {tool.author}
                    </span>
                  </span>
                  <span class="mt-2 block text-sm leading-relaxed text-gray-400">
                    {tool.description}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

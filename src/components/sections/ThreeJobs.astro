---
import Topology from '../diagrams/Topology.astro';

const jobs = [
  {
    job: 'Storage & delivery',
    answer: 'Dumb, interchangeable relays',
    body: 'Sealed blobs addressed to rotating labels. One misbehaves? Use the others.',
    detail: 'CORD-01',
    href: '/spec/cord-01/',
  },
  {
    job: 'Who is a member?',
    answer: 'Key possession',
    body: 'Decrypt the room and you are in it. No list to leak, subpoena, or deny.',
    detail: 'CORD-02',
    href: '/spec/cord-02/',
  },
  {
    job: 'Who is in charge?',
    answer: 'A signed roster',
    body: 'Every ban traces to the owner’s key. A forged one is dropped, not obeyed.',
    detail: 'CORD-04',
    href: '/spec/cord-04/',
  },
];
---

<section class="border-b border-hairline">
  <div class="mx-auto max-w-6xl px-5 py-24">
    <p class="cx-eyebrow">The idea</p>
    <h2
      class="mt-4 max-w-3xl text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
    >
      Every group chat you have ever used has a computer in the middle.
    </h2>

    {/*
      The pair carries the argument the three paragraphs here used to. Same six
      members in the same ring on both sides, so the only thing that changes
      between the pictures is the middle — and the palette says which one is
      yours before a word is read.
    */}
    <div class="mt-12 grid gap-4 lg:grid-cols-2">
      <div class="rounded-xl border border-hairline bg-raised/40 p-6 sm:p-8">
        <p class="cx-eyebrow cx-eyebrow-muted">Every other group chat</p>
        <Topology
          variant="hosted"
          class="mt-6"
          label="Six members, every one of them connected to a single central server that all their messages pass through."
        />
        <p class="mt-6 text-sm leading-relaxed text-gray-400">
          One computer holds every message, knows every member, and is the final
          say on who can do what. It can be subpoenaed, hacked, sold, or
          switched off — and your community goes with it.
        </p>
      </div>

      <div class="rounded-xl border border-mint/20 bg-raised/40 p-6 sm:p-8">
        <p class="cx-eyebrow">Concord</p>
        <Topology
          variant="concord"
          class="mt-6"
          label="The same six members, each connected to two of three interchangeable relays, with sealed packets on every wire and nothing at the centre."
        />
        <p class="mt-6 text-sm leading-relaxed text-gray-300">
          Nothing in the middle. Relays are interchangeable and carry only
          sealed packets, so losing one costs you nothing and trusting one buys
          you nothing.
        </p>
      </div>
    </div>

    <p
      class="mt-16 max-w-2xl text-base leading-relaxed text-gray-300 sm:text-lg"
    >
      Concord splits that computer's three jobs into pieces that need to trust
      nobody.
    </p>

    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      {
        jobs.map((job, index) => (
          <a href={job.href} class="cx-card cx-card-link group block p-7">
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-mono text-xs text-gray-500">
                0{index + 1}
              </span>
              <span class="font-mono text-[0.65rem] uppercase tracking-wider text-gray-600 transition-colors group-hover:text-mint">
                {job.detail}
              </span>
            </div>

            <p class="mt-6 text-sm text-gray-400">{job.job}</p>
            <p
              class="mt-1 text-xl font-semibold tracking-tight text-white"
              aria-hidden="true"
            >
              <span class="mr-2 text-mint">&rarr;</span>
              {job.answer}
            </p>

            <p class="mt-5 text-sm leading-relaxed text-gray-400">{job.body}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

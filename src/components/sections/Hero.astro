---
import Logo from '../Logo.astro';

const title = 'Concord Protocol';

/*
 * The wordmark is split so each letter can land on its own beat, but grouped by
 * word: a lone space between two flex items collapses to nothing, so the gap
 * between the words has to be a real gap. The stagger index runs across the
 * whole title so the second word carries on from the first rather than
 * restarting. The <h1> is labelled, so assistive tech gets the title rather
 * than a spelling-out of it.
 */
let letters = 0;
const wordmark = title.split(' ').map((word) => [...word].map((char) => ({ char, i: letters++ })));
---

{/*
  The opening screen holds the lockup and the tagline, and nothing else — the
  paragraph and the buttons that used to follow them are gone; the two apps sit
  directly under the fold, and the page makes its case in The Idea below them.

  The lockup is centred, but on uneven padding, so it lands roughly 3% of the
  screen above the true middle. Dead centre sits low once the scroll cue is
  counted, and a flat offset from the top swung between too high and too low as
  the viewport changed height; in svh the lift tracks the screen. It comes out
  under the 5svh the padding implies, because the ink sits a little low in its
  own box — the mark's viewBox is inset at the top and the tagline carries
  descender space at the bottom. Its height subtracts the
  nav, which is sticky and so occupies flow space above — 4rem on md+, plus the
  ~2.25rem mobile nav row below it on smaller screens.
*/}
<section class="relative overflow-hidden">
  {/*
    One layer, not two: on the hero the glow is not painted behind the grid, it
    is painted *into* it. See `.cx-grid-bg-center`.
  */}
  <div class="cx-grid-bg cx-grid-bg-center pointer-events-none absolute inset-0">
  </div>

  {/*
    The cells a press has been dragged through, still glowing. A canvas rather
    than more CSS: what's on screen is a decaying set of cells, and one rect
    each is cheaper than a gradient layer per cell. It shares the grid's box, so
    the same 72px lattice addresses both, and it sits under the lockup, so a
    tile lights *behind* the wordmark rather than washing over it.
  */}
  <canvas
    class="cx-grid-spark pointer-events-none absolute inset-0 h-full w-full"
    data-grid-spark
    aria-hidden="true"></canvas>

  <div
    class="relative mx-auto flex min-h-[calc(100svh-6.25rem)] max-w-5xl flex-col items-center justify-center px-5 pb-[16svh] pt-[6svh] text-center md:min-h-[calc(100svh-4rem)]"
  >
    {/*
      Stacked: the mark is the statement and the title is its caption, so the
      mark is set large and the words sit under it, small and letterspaced.
      Unlike the side-by-side lockup this needs no optical fudge — the ring is
      inked all the way to the bottom of its viewBox, so the gap here is a real
      one.
    */}
    <h1
      aria-label={title}
      class="flex flex-col items-center gap-6 text-[1.6rem] text-white sm:gap-8 sm:text-5xl lg:text-6xl"
    >
      {/*
        Nudged right by 8.8% of its own width. The ring is cut away on its right
        for the "C", so its ink spans 8.5–97 of a 128 viewBox and its optical
        centre sits left of the box's — invisible in the nav at 22px, but a
        clear misalignment against a wordmark centred beneath it.

        The margins are twice that 8.8%, because `items-center` centres the box
        *including* its margins and so splits the value between the two sides.
      */}
      {/*
        Three boxes around the one mark, because three things move it and they
        must not fight over the same `transform`:

          - the hit box carries the optical nudge and the layout, and is the
            only one that never moves — a hover target that rotated and grew
            under the cursor would flicker at its own edges;
          - the tilt box turns toward the cursor and lifts on hover;
          - the spin box takes the click's full turn.

        The nudge has to live out here rather than on the mark itself: a
        margin counts toward an inline-block's shrink-to-fit width, so a tilt
        box holding it would centre — and therefore rotate — about a point
        offset from the mark, and the mark would orbit instead of spinning.
      */}
      <span class="cx-mark-hit ms-6 shrink-0 sm:ms-9 lg:ms-11" data-mark>
        <span class="cx-mark-tilt">
          <span class="cx-mark-spin">
            <Logo animate class="h-36 w-36 sm:h-52 sm:w-52 lg:h-64 lg:w-64" />
          </span>
        </span>
      </span>
      <span class="cx-wordmark">
        {
          wordmark.map((word) => (
            <span class="cx-wordmark-word">
              {word.map(({ char, i }) => (
                <span class="cx-wordmark-letter" style={`--cx-i:${i}`}>
                  {char}
                </span>
              ))}
            </span>
          ))
        }
      </span>
    </h1>

    {/*
      The tagline arrives as ciphertext and decodes left to right, the way
      Armada's landing page resolves its heading. Both spans hold their real
      text in the markup, so no-JS, reduced motion, and every crawler get the
      finished line; the script below is what garbles it.

      The space belongs to the first span, and is written as an expression:
      Astro's compressHTML strips whitespace *between* elements outright (a
      plain newline there produced "communities.Open") and would trim a literal
      trailing one. Inside the span it is a character the decode can garble like
      any other, which is the point — a gap left standing in the ciphertext
      shows the shape of the sentence underneath it.
    */}
    <p
      class="cx-tagline mt-8 text-balance text-xl font-medium leading-snug tracking-tight text-gray-200 sm:mt-10 sm:text-3xl"
    >
      <span data-decode>{'Private communities. '}</span><span
        class="text-mint"
        data-decode>Open protocol.</span
      >
    </p>
  </div>

  {/*
    The cue carries most of the burden of saying there is more, so it keeps the
    small viewports it used to skip. It stays unlabelled: the tagline is already
    the second thing on the screen, and a caption would make it the third.
  */}
  <a
    href="#apps"
    aria-label="Scroll down"
    class="absolute inset-x-0 bottom-6 mx-auto flex w-fit flex-col items-center gap-2 text-gray-500 transition-colors hover:text-mint"
  >
    <span class="cx-scroll-cue text-2xl leading-none" aria-hidden="true"
      >&darr;</span
    >
  </a>
</section>

<script>
  /*
   * The tagline, decrypting.
   *
   * Ported from Armada's landing page, where the heading arrives as hex and
   * resolves left to right. Armada's is a dozen lines because that heading is
   * `font-mono whitespace-nowrap`: every glyph is the same width, so it can
   * swap a plain string and nothing can reflow. This one is set in a
   * proportional face, so the widths have to be managed by hand — everything
   * below is that, and nothing else. The behaviour is Armada's, including
   * garbling the spaces: a gap left standing in the ciphertext draws the shape
   * of the sentence hiding under it.
   */
  const GLYPHS = '0123456789abcdef';
  const TICK_MS = 40;

  const noise = () => GLYPHS[(Math.random() * GLYPHS.length) | 0];

  /** One character: the box on screen, what it will become, and how wide that is. */
  type Cell = { el: HTMLElement; ch: string; advance: number };

  /**
   * A left-to-right resolve taking `durationMs`, beginning at `startMs`.
   *
   * Before `startMs` the cells sit on noise. That hold is deliberately short —
   * long enough to register as ciphertext, not long enough to read as a stall.
   *
   * A settled cell gets its own advance and the unsettled ones split whatever
   * width is left, evenly. Those two always sum to the run's natural width, so
   * the line never changes width and a centred one never moves — and while it
   * is still noise the cells are uniform, which is what makes it read as a
   * block of cipher rather than as words with the letters swapped.
   */
  function decode(
    cells: Cell[],
    t0: number,
    startMs: number,
    durationMs: number,
    restore: () => void,
  ) {
    const layout = (settled: number) => {
      let rest = 0;
      for (let i = settled; i < cells.length; i++) rest += cells[i].advance;
      const uniform = rest / Math.max(1, cells.length - settled);
      cells.forEach((cell, i) => {
        cell.el.style.width = `${i < settled ? cell.advance : uniform}px`;
      });
    };

    for (const cell of cells) cell.el.textContent = noise();
    layout(0);

    let settled = 0;

    const timer = setInterval(() => {
      const elapsed = performance.now() - t0 - startMs;
      const target =
        elapsed <= 0 ? 0 : Math.round((elapsed / durationMs) * cells.length);

      if (target >= cells.length) {
        clearInterval(timer);
        restore();
        return;
      }

      for (; settled < target; settled++) {
        cells[settled].el.textContent = cells[settled].ch;
      }
      for (let i = target; i < cells.length; i++) {
        cells[i].el.textContent = noise();
      }
      layout(target);
    }, TICK_MS);
  }

  /*
   * Anchored here, next to where the CSS animations start, but nothing is
   * measured until the webfonts are in. Measuring against the fallback face
   * pinned every box about 10% too wide — the tagline came out 522px instead of
   * 474 — and the line then snapped narrower the moment it resolved. Keeping t0
   * out here means a slow font shortens the decode rather than sliding it out
   * of step with the fade it is supposed to arrive under.
   */
  const t0 = performance.now();

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    await document.fonts.ready;

    /*
     * The tagline, and only the tagline: the wordmark draws itself in and a
     * decode over the top of that was one flourish too many on the same beat.
     * Both spans hold their real text in the markup, so this is the only thing
     * that ever garbles it.
     */
    const segments = [
      ...document.querySelectorAll<HTMLElement>('.cx-tagline [data-decode]'),
    ];

    const original = segments.map((el) => el.textContent ?? '');
    const cells: Cell[] = [];
    const range = document.createRange();

    segments.forEach((el, s) => {
      const text = original[s];
      const source = el.firstChild;
      if (!source) return;

      /*
       * A character's width has to be its advance in this particular line, the
       * tracking and the kerning included, and neither a one-character span nor
       * a one-character Range reports that — both give the bare glyph box, and
       * measured that way the sentence came out 41px wider garbled than
       * resolved. So the Range grows from the start of the text and each
       * advance is the difference between two prefix widths. Those telescope:
       * they sum to the width of the whole run by construction.
       *
       * Every read happens here, while the text node being measured is still
       * the one on screen; the replacement is built detached and swapped in
       * afterwards.
       */
      const advance: number[] = [];
      let prefix = 0;
      range.setStart(source, 0);
      for (let i = 0; i < text.length; i++) {
        range.setEnd(source, i + 1);
        const width = range.getBoundingClientRect().width;
        advance.push(width - prefix);
        prefix = width;
      }

      const frag = document.createDocumentFragment();
      let word: HTMLElement | null = null;

      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        const cell = document.createElement('span');
        cell.className = 'cx-dc-char';

        if (/\s/.test(ch)) {
          /* A space gets a box like any other character, but sits outside the
             words: adjacent inline-blocks are a break opportunity and the
             insides of a word are not, so the line still wraps where the plain
             text did. */
          frag.append(cell);
          word = null;
        } else {
          if (!word) {
            word = document.createElement('span');
            word.className = 'cx-dc-word';
            frag.append(word);
          }
          word.append(cell);
        }

        cells.push({ el: cell, ch, advance: advance[i] });
      }

      el.replaceChildren(frag);
    });

    if (cells.length) {
      /* 1450ms is `.cx-tagline`'s animation-delay, so the line is visible from
         then on. It holds on noise for a fifth of a second past that, long
         enough to be read as ciphertext, and then resolves. */
      decode(cells, t0, 1450 + 200, 950, () => {
        /* Back to plain text nodes: the pinned widths would survive a resize
           and a font swap, and neither is theirs to survive. */
        segments.forEach((el, s) => {
          el.textContent = original[s];
        });
      });
    }
  }
</script>

<script>
  /*
   * The hero, under the cursor.
   *
   * Two effects off one pointer: the grid lights the cells a press is dragged
   * through and lets them fade, and the mark turns to face the cursor,
   * spinning and flaring when clicked. Both are ornament — the screen is
   * finished without either — so both are skipped outright under reduced
   * motion. Only the mark's lean is gated on a fine pointer, because it is
   * the only part that answers hovering; everything else is driven by a press
   * and so works the same under a finger.
   */
  /** .cx-grid-bg's `background-size`; the canvas shares its box and its origin. */
  const CELL = 72;
  const MINT = '36, 232, 163';
  /** How long a lit tile takes to fade back to black. */
  const LIFE = 1100;
  /** How much of the cursor's bearing the mark takes on. */
  const FOLLOW = 0.45;
  /** Turns the mark will wind up before it stops following. */
  const WIND = 720;

  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * The grid, lighting up where it has been pressed.
   *
   * A cell is lit outright the moment the press reaches it and fades from
   * there, so the effect reads as ignition and a trail rather than as a blob
   * that follows. Cells are keyed by lattice index, so re-entering one simply
   * resets its clock, and the map holds only what is still visible — the loop
   * stops the frame the last cell goes out.
   */
  function lightGrid(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;
    if (!ctx || !host) return;

    /** Lattice index "i,j" to the time it was last touched. */
    const lit = new Map<string, number>();
    let width = 0;
    let height = 0;
    let frame = 0;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      /* Capped: past 2x the extra pixels are invisible and the fill rate is
         not. The transform then lets everything below work in CSS px. */
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    resize();
    /* The canvas is sized by CSS, and `width`/`height` are its buffer rather
       than its box, so setting them here cannot feed back into this. */
    new ResizeObserver(resize).observe(canvas);

    const draw = () => {
      frame = 0;
      const now = performance.now();
      ctx.clearRect(0, 0, width, height);

      for (const [key, at] of lit) {
        const p = (now - at) / LIFE;
        if (p >= 1) {
          lit.delete(key);
          continue;
        }
        /* Squared, so a tile drops out of the way quickly and then lingers
           faintly — a linear fade reads as a hard edge sweeping past. */
        const k = (1 - p) * (1 - p);
        const comma = key.indexOf(',');
        const x = +key.slice(0, comma) * CELL;
        const y = +key.slice(comma + 1) * CELL;

        /* The tile, inset by a pixel on each side so the grid's own lines
           stay the grid's, and then its four edges painted directly over
           them: the fill says which cell, the edges are what makes it read
           as the lattice lighting up rather than as a square drawn on top.
           `+0.5` centres a 1px stroke on the same column the CSS line
           occupies, so the two land on the same device pixels. */
        ctx.fillStyle = `rgba(${MINT}, ${0.1 * k})`;
        ctx.fillRect(x + 1, y + 1, CELL - 2, CELL - 2);
        ctx.strokeStyle = `rgba(${MINT}, ${0.55 * k})`;
        ctx.lineWidth = 1;
        ctx.strokeRect(x + 0.5, y + 0.5, CELL, CELL);
      }

      if (lit.size) frame = requestAnimationFrame(draw);
    };

    const at = (x: number, y: number) => {
      lit.set(`${Math.floor(x / CELL)},${Math.floor(y / CELL)}`, performance.now());
    };

    /* Where the held pointer was last seen, or null when nothing is held —
       which is also what says whether a move should light anything at all. */
    let last: { x: number; y: number } | null = null;

    /** The pointer position in canvas space, or null if it is outside. */
    const place = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      if (x < 0 || y < 0 || x > width || y > height) return null;
      return { x, y };
    };

    /* Pressed, not passed over. Hovering lit the grid wherever the cursor
       happened to travel, which meant the effect was mostly on by accident;
       requiring the button makes it something you do. It also gives touch the
       same effect for free — a drag is a held pointer either way — so this
       half of the script is not gated on a fine pointer. */
    host.addEventListener('pointerdown', (e: PointerEvent) => {
      /* The mark answers a press itself, with a spin and a flare. A tile
         lighting under it at the same time is a second effect on the same
         click, and the two only get in each other's way. */
      const target = e.target as Element | null;
      if (target?.closest('[data-mark]')) return;

      const p = place(e);
      if (!p) return;

      /* A drag here draws a trail, so it must not also drag out a selection:
         the trail crosses the wordmark and the tagline, and the browser would
         highlight both on the way past. Suppressed only for presses that begin
         off the text, so selecting a line by dragging along it still works,
         and only until the press ends. pointerdown runs ahead of the mousedown
         that would start the selection, so setting it here is in time. */
      if (!target?.closest('h1, p, a, button')) {
        host.style.userSelect = 'none';
      }

      at(p.x, p.y);
      last = p;
      if (!frame) frame = requestAnimationFrame(draw);
    });

    host.addEventListener(
      'pointermove',
      (e: PointerEvent) => {
        if (!last) return;

        const p = place(e);
        if (!p) {
          /* Held, but dragged off the section. The trail resumes from
             wherever it comes back in rather than across the gap. */
          last = null;
          return;
        }

        /* A pointer moving fast enough reports a handful of positions a
           whole screen apart, and lighting only those leaves gaps in the
           trail. So the segment since the last one is walked at a third of a
           cell — fine enough to miss nothing, bounded so a jump across the
           window can't cost more than a couple of dozen cells. */
        const dx = p.x - last.x;
        const dy = p.y - last.y;
        const steps = Math.min(24, Math.ceil(Math.hypot(dx, dy) / (CELL / 3)));
        for (let s = 1; s < steps; s++) {
          at(last.x + (dx * s) / steps, last.y + (dy * s) / steps);
        }

        at(p.x, p.y);
        last = p;
        if (!frame) frame = requestAnimationFrame(draw);
      },
      { passive: true },
    );

    /* On window, not host: a press that ends outside the section — or is
       taken away by a scroll gesture — has to release the trail too, and
       neither event reaches the host. */
    for (const end of ['pointerup', 'pointercancel'] as const) {
      addEventListener(end, () => {
        last = null;
        host.style.userSelect = '';
      });
    }
  }

  /**
   * The mark, answering the cursor.
   *
   * Hovering turns it toward wherever the cursor is — a fraction of the true
   * bearing, so it leans rather than points, and so a flick around the mark
   * winds it round. Clicking spins it once and fires the entrance's flash and
   * departing ring again.
   */
  function liven(hit: HTMLElement) {
    const tilt = hit.querySelector<HTMLElement>('.cx-mark-tilt');
    const spin = hit.querySelector<HTMLElement>('.cx-mark-spin');
    const glow = hit.querySelector<SVGElement>('.cx-mark-flash');
    const wave = hit.querySelector<SVGElement>('.cx-mark-wave');
    if (!tilt || !spin) return;

    hit.dataset.live = '';

    if (fine) {
      /*
       * The bearing, unwrapped. atan2 jumps by a full turn as the cursor
       * crosses the ray running left from the centre, which is a whip on
       * screen and sits right where the cursor is likely to cross; carrying
       * the angle forward by its shortest step instead makes that crossing
       * continuous, at the price — the point, really — of the mark winding up
       * if the cursor keeps circling. Null when the cursor is away, so
       * arriving is an absolute reading and the mark whips round to meet it.
       */
      let bearing: number | null = null;

      hit.addEventListener('pointermove', (e) => {
        const rect = hit.getBoundingClientRect();
        const a =
          (Math.atan2(
            e.clientY - (rect.top + rect.height / 2),
            e.clientX - (rect.left + rect.width / 2),
          ) *
            180) /
          Math.PI;

        if (bearing === null) {
          bearing = a;
        } else {
          let step = (a - bearing) % 360;
          if (step > 180) step -= 360;
          else if (step < -180) step += 360;
          bearing = Math.max(-WIND, Math.min(WIND, bearing + step));
        }

        tilt.style.setProperty('--cx-tilt', `${(bearing * FOLLOW).toFixed(1)}deg`);
      });

      hit.addEventListener('pointerleave', () => {
        bearing = null;
        /* Back to upright the long way if it wound up, which is the reward
           for having wound it up. */
        tilt.style.setProperty('--cx-tilt', '0deg');
      });
    }

    /*
     * The click, in three parts on three elements, so none of them has to be
     * unpicked from the CSS that already drives it. These are Web Animations
     * rather than classes for exactly that reason: a script-driven animation
     * outranks a CSS one while it runs and hands the property straight back
     * when it finishes, so the entrance's own `both`-filled resting values
     * survive underneath and there is nothing to restart or clean up. The
     * spin gets its own box so the follow above can keep steering during it.
     */
    let running: Animation[] = [];

    hit.addEventListener('click', () => {
      for (const anim of running) anim.cancel();
      running = [];

      running.push(
        spin.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }], {
          duration: 900,
          easing: 'cubic-bezier(0.65, 0, 0.2, 1)',
        }),
      );

      /* Both ends sit on the halo's resting opacity, so handing the property
         back at the end is invisible. */
      if (glow) {
        running.push(
          glow.animate([{ opacity: 0.24 }, { opacity: 1, offset: 0.3 }, { opacity: 0.24 }], {
            duration: 900,
            easing: 'ease-in-out',
          }),
        );
      }

      if (wave) {
        running.push(
          wave.animate(
            [
              { opacity: 0.6, transform: 'scale(1)' },
              { opacity: 0, transform: 'scale(1.6)' },
            ],
            { duration: 900, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          ),
        );
      }
    });
  }

  if (!still) {
    const mark = document.querySelector<HTMLElement>('[data-mark]');
    if (mark) liven(mark);

    const canvas = document.querySelector<HTMLCanvasElement>('[data-grid-spark]');
    if (canvas) lightGrid(canvas);
  }
</script>

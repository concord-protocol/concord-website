---
import Logo from '../Logo.astro';

const title = 'Concord Protocol';

/*
 * Each letter is its own span so the entrance can stagger them. Letters are
 * grouped by word, because a space between flex items collapses. The stagger
 * index runs across both words. The <h1> carries an aria-label so screen
 * readers get the title, not the individual letters.
 */
let letters = 0;
const wordmark = title.split(' ').map((word) => [...word].map((char) => ({ char, i: letters++ })));
---

{/*
  The lockup and tagline, nothing else. The uneven padding (6svh top, 16svh
  bottom) lifts the lockup slightly above centre to leave room for the scroll
  cue. The min-height subtracts the sticky nav: 4rem on md+, plus the ~2.25rem
  mobile link row below that.
*/}
<section class="relative overflow-hidden">
  {/* The glow is painted into the grid itself; see `.cx-grid-bg-center`. */}
  <div class="cx-grid-bg cx-grid-bg-center pointer-events-none absolute inset-0">
  </div>

  {/*
    Grid cells lit by a press-and-drag, fading out. Shares the grid's box and
    72px lattice, and sits under the lockup.
  */}
  <canvas
    class="cx-grid-spark pointer-events-none absolute inset-0 h-full w-full"
    data-grid-spark
    aria-hidden="true"></canvas>

  <div
    class="relative mx-auto flex min-h-[calc(100svh-6.25rem)] max-w-5xl flex-col items-center justify-center px-5 pb-[16svh] pt-[6svh] text-center md:min-h-[calc(100svh-4rem)]"
  >
    <h1
      aria-label={title}
      class="flex flex-col items-center gap-6 text-[1.6rem] text-white sm:gap-8 sm:text-5xl lg:text-6xl"
    >
      {/*
        The mark's ink spans 8.5–97 of its 128 viewBox, so its optical centre
        sits left of the box. The start margin shifts it right by 8.8% of its
        width; the margin is twice that because `items-center` splits it
        between both sides.

        Three nested boxes so three transforms don't collide: the hit box holds
        the layout and the nudge and never moves (a moving hover target
        flickers at its edges), the tilt box follows the cursor, and the spin
        box takes the click. The nudge can't go on the tilt box, or the mark
        would rotate around an off-centre point.
      */}
      <span class="cx-mark-hit ms-6 shrink-0 sm:ms-9 lg:ms-11" data-mark>
        <span class="cx-mark-tilt">
          <span class="cx-mark-spin">
            <Logo animate class="h-36 w-36 sm:h-52 sm:w-52 lg:h-64 lg:w-64" />
          </span>
        </span>
      </span>
      <span class="cx-wordmark">
        {
          wordmark.map((word) => (
            <span class="cx-wordmark-word">
              {word.map(({ char, i }) => (
                <span class="cx-wordmark-letter" style={`--cx-i:${i}`}>
                  {char}
                </span>
              ))}
            </span>
          ))
        }
      </span>
    </h1>

    {/*
      The script below scrambles this and decodes it left to right. The markup
      holds the real text, so no-JS, reduced motion, and crawlers see it as is.

      The space is written as an expression inside the first span because
      compressHTML strips whitespace between elements and trims a trailing
      literal one.
    */}
    <p
      class="cx-tagline mt-8 text-balance text-xl font-medium leading-snug tracking-tight text-gray-200 sm:mt-10 sm:text-3xl"
    >
      <span data-decode>{'Private communities. '}</span><span
        class="text-mint"
        data-decode>Open protocol.</span
      >
    </p>
  </div>

  <a
    href="#apps"
    aria-label="Scroll down"
    class="absolute inset-x-0 bottom-6 mx-auto flex w-fit flex-col items-center gap-2 text-gray-500 transition-colors hover:text-mint"
  >
    <span class="cx-scroll-cue text-2xl leading-none" aria-hidden="true"
      >&darr;</span
    >
  </a>
</section>

<script>
  /*
   * The tagline decode, ported from Armada's landing page. Armada's heading is
   * monospace, so it can swap strings directly. This one is proportional, so
   * each character's width is measured and pinned to keep the line from
   * reflowing while it decodes.
   */
  const GLYPHS = '0123456789abcdef';
  const TICK_MS = 40;

  const noise = () => GLYPHS[(Math.random() * GLYPHS.length) | 0];

  /** One character: the box on screen, what it will become, and how wide that is. */
  type Cell = { el: HTMLElement; ch: string; advance: number };

  /**
   * Resolves `cells` left to right over `durationMs`, starting at `startMs`
   * after `t0`. Settled cells take their own width and unsettled cells split
   * the rest evenly, so the line's total width never changes.
   */
  function decode(
    cells: Cell[],
    t0: number,
    startMs: number,
    durationMs: number,
    restore: () => void,
  ) {
    const layout = (settled: number) => {
      let rest = 0;
      for (let i = settled; i < cells.length; i++) rest += cells[i].advance;
      const uniform = rest / Math.max(1, cells.length - settled);
      cells.forEach((cell, i) => {
        cell.el.style.width = `${i < settled ? cell.advance : uniform}px`;
      });
    };

    for (const cell of cells) cell.el.textContent = noise();
    layout(0);

    let settled = 0;

    const timer = setInterval(() => {
      const elapsed = performance.now() - t0 - startMs;
      const target =
        elapsed <= 0 ? 0 : Math.round((elapsed / durationMs) * cells.length);

      if (target >= cells.length) {
        clearInterval(timer);
        restore();
        return;
      }

      for (; settled < target; settled++) {
        cells[settled].el.textContent = cells[settled].ch;
      }
      for (let i = target; i < cells.length; i++) {
        cells[i].el.textContent = noise();
      }
      layout(target);
    }, TICK_MS);
  }

  /*
   * t0 is taken before waiting for webfonts, so a slow font shortens the
   * decode instead of putting it out of step with the CSS fade-in. Measuring
   * before the fonts load would pin widths from the fallback face.
   */
  const t0 = performance.now();

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    await document.fonts.ready;

    const segments = [
      ...document.querySelectorAll<HTMLElement>('.cx-tagline [data-decode]'),
    ];

    const original = segments.map((el) => el.textContent ?? '');
    const cells: Cell[] = [];
    const range = document.createRange();

    segments.forEach((el, s) => {
      const text = original[s];
      const source = el.firstChild;
      if (!source) return;

      /*
       * Each advance is the difference between two prefix widths, which
       * includes tracking and kerning. Measuring single characters gives the
       * bare glyph box and overshoots. All reads happen before the text node
       * is replaced.
       */
      const advance: number[] = [];
      let prefix = 0;
      range.setStart(source, 0);
      for (let i = 0; i < text.length; i++) {
        range.setEnd(source, i + 1);
        const width = range.getBoundingClientRect().width;
        advance.push(width - prefix);
        prefix = width;
      }

      const frag = document.createDocumentFragment();
      let word: HTMLElement | null = null;

      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        const cell = document.createElement('span');
        cell.className = 'cx-dc-char';

        if (/\s/.test(ch)) {
          /* Spaces sit outside the word spans so the line wraps where the
             plain text would. */
          frag.append(cell);
          word = null;
        } else {
          if (!word) {
            word = document.createElement('span');
            word.className = 'cx-dc-word';
            frag.append(word);
          }
          word.append(cell);
        }

        cells.push({ el: cell, ch, advance: advance[i] });
      }

      el.replaceChildren(frag);
    });

    if (cells.length) {
      /* 1450ms is `.cx-tagline`'s animation-delay; hold on noise for 200ms
         after it appears, then resolve. */
      decode(cells, t0, 1450 + 200, 950, () => {
        /* Restore plain text so the pinned widths don't outlive a resize. */
        segments.forEach((el, s) => {
          el.textContent = original[s];
        });
      });
    }
  }
</script>

<script>
  /*
   * Pointer effects: dragging lights grid cells, and the mark leans toward the
   * cursor and spins on click. Both are skipped under reduced motion. Only the
   * lean needs a fine pointer; the rest is press-driven and works on touch.
   */
  /** .cx-grid-bg's `background-size`; the canvas shares its box and its origin. */
  const CELL = 72;
  const MINT = '36, 232, 163';
  /** How long a lit tile takes to fade back to black. */
  const LIFE = 1100;
  /** How much of the cursor's bearing the mark takes on. */
  const FOLLOW = 0.45;
  /** Turns the mark will wind up before it stops following. */
  const WIND = 720;

  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * Lights each grid cell a press-and-drag passes through, then fades it.
   * The animation loop stops once no cells are lit.
   */
  function lightGrid(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;
    if (!ctx || !host) return;

    /** Lattice index "i,j" to the time it was last touched. */
    const lit = new Map<string, number>();
    let width = 0;
    let height = 0;
    let frame = 0;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      /* Capped at 2x. The transform lets drawing work in CSS px. */
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    resize();
    /* Setting the buffer size doesn't change the CSS box, so this can't loop. */
    new ResizeObserver(resize).observe(canvas);

    const draw = () => {
      frame = 0;
      const now = performance.now();
      ctx.clearRect(0, 0, width, height);

      for (const [key, at] of lit) {
        const p = (now - at) / LIFE;
        if (p >= 1) {
          lit.delete(key);
          continue;
        }
        /* Quadratic fade: drops quickly, then lingers faintly. */
        const k = (1 - p) * (1 - p);
        const comma = key.indexOf(',');
        const x = +key.slice(0, comma) * CELL;
        const y = +key.slice(comma + 1) * CELL;

        /* Fill inset by 1px, then stroke the edges over the CSS grid lines.
           `+0.5` puts the 1px stroke on the same pixels as the CSS line. */
        ctx.fillStyle = `rgba(${MINT}, ${0.1 * k})`;
        ctx.fillRect(x + 1, y + 1, CELL - 2, CELL - 2);
        ctx.strokeStyle = `rgba(${MINT}, ${0.55 * k})`;
        ctx.lineWidth = 1;
        ctx.strokeRect(x + 0.5, y + 0.5, CELL, CELL);
      }

      if (lit.size) frame = requestAnimationFrame(draw);
    };

    const at = (x: number, y: number) => {
      lit.set(`${Math.floor(x / CELL)},${Math.floor(y / CELL)}`, performance.now());
    };

    /* Last position of the held pointer, or null when nothing is held. */
    let last: { x: number; y: number } | null = null;

    /** The pointer position in canvas space, or null if it is outside. */
    const place = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      if (x < 0 || y < 0 || x > width || y > height) return null;
      return { x, y };
    };

    /* Press-driven rather than hover-driven, so it's intentional and works
       the same on touch. */
    host.addEventListener('pointerdown', (e: PointerEvent) => {
      /* The mark, links, and buttons have their own click behaviour. */
      const target = e.target as Element | null;
      if (target?.closest('[data-mark], a, button')) return;

      const p = place(e);
      if (!p) return;

      /* Stop a trail drag from selecting text, but only when the press starts
         off the text, so the heading and tagline remain selectable. */
      if (!target?.closest('h1, p')) {
        host.style.userSelect = 'none';
      }

      at(p.x, p.y);
      last = p;
      if (!frame) frame = requestAnimationFrame(draw);
    });

    host.addEventListener(
      'pointermove',
      (e: PointerEvent) => {
        if (!last) return;

        const p = place(e);
        if (!p) {
          /* Dragged off the section: restart the trail when it returns. */
          last = null;
          return;
        }

        /* Fast moves report sparse positions, so walk the segment in
           third-of-a-cell steps (at most 24) to avoid gaps. */
        const dx = p.x - last.x;
        const dy = p.y - last.y;
        const steps = Math.min(24, Math.ceil(Math.hypot(dx, dy) / (CELL / 3)));
        for (let s = 1; s < steps; s++) {
          at(last.x + (dx * s) / steps, last.y + (dy * s) / steps);
        }

        at(p.x, p.y);
        last = p;
        if (!frame) frame = requestAnimationFrame(draw);
      },
      { passive: true },
    );

    /* On window, so a press released outside the section or cancelled by a
       scroll still ends the trail. */
    for (const end of ['pointerup', 'pointercancel'] as const) {
      addEventListener(end, () => {
        last = null;
        host.style.userSelect = '';
      });
    }
  }

  /**
   * Hovering leans the mark toward the cursor by a fraction of the bearing.
   * Clicking spins it once and replays the entrance's flash and ring.
   */
  function liven(hit: HTMLElement) {
    const tilt = hit.querySelector<HTMLElement>('.cx-mark-tilt');
    const spin = hit.querySelector<HTMLElement>('.cx-mark-spin');
    const glow = hit.querySelector<SVGElement>('.cx-mark-flash');
    const wave = hit.querySelector<SVGElement>('.cx-mark-wave');
    if (!tilt || !spin) return;

    hit.dataset.live = '';

    if (fine) {
      /*
       * The bearing, unwrapped: advanced by the shortest step each move so it
       * doesn't jump 360° where atan2 wraps. Circling the cursor winds it up,
       * clamped to WIND. Null while the cursor is away.
       */
      let bearing: number | null = null;

      hit.addEventListener('pointermove', (e) => {
        const rect = hit.getBoundingClientRect();
        const a =
          (Math.atan2(
            e.clientY - (rect.top + rect.height / 2),
            e.clientX - (rect.left + rect.width / 2),
          ) *
            180) /
          Math.PI;

        if (bearing === null) {
          bearing = a;
        } else {
          let step = (a - bearing) % 360;
          if (step > 180) step -= 360;
          else if (step < -180) step += 360;
          bearing = Math.max(-WIND, Math.min(WIND, bearing + step));
        }

        tilt.style.setProperty('--cx-tilt', `${(bearing * FOLLOW).toFixed(1)}deg`);
      });

      hit.addEventListener('pointerleave', () => {
        bearing = null;
        /* Unwinds the long way if it was wound up. */
        tilt.style.setProperty('--cx-tilt', '0deg');
      });
    }

    /*
     * Web Animations rather than classes: they override the CSS entrance
     * animations while running and hand the properties back when done, so
     * there's nothing to reset.
     */
    let running: Animation[] = [];

    hit.addEventListener('click', () => {
      for (const anim of running) anim.cancel();
      running = [];

      running.push(
        spin.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }], {
          duration: 900,
          easing: 'cubic-bezier(0.65, 0, 0.2, 1)',
        }),
      );

      /* Starts and ends at the halo's resting opacity. */
      if (glow) {
        running.push(
          glow.animate([{ opacity: 0.24 }, { opacity: 1, offset: 0.3 }, { opacity: 0.24 }], {
            duration: 900,
            easing: 'ease-in-out',
          }),
        );
      }

      if (wave) {
        running.push(
          wave.animate(
            [
              { opacity: 0.6, transform: 'scale(1)' },
              { opacity: 0, transform: 'scale(1.6)' },
            ],
            { duration: 900, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          ),
        );
      }
    });
  }

  if (!still) {
    const mark = document.querySelector<HTMLElement>('[data-mark]');
    if (mark) liven(mark);

    const canvas = document.querySelector<HTMLCanvasElement>('[data-grid-spark]');
    if (canvas) lightGrid(canvas);
  }
</script>
